                kbTarget.ShowInList = not kbTarget.ShowInList
                showCheckDot.BackgroundColor3 = kbTarget.ShowInList and ctx.Theme.Accent or Color3.fromRGB(48, 58, 76)
                ctx.RefreshHotkeys()
            end
        end)
    end

    do
        local clr = U.New("TextButton", {
            Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Color3.fromRGB(58, 22, 28),
            BackgroundTransparency = 1, BorderSizePixel = 0, Text = "  Clear Key",
            TextColor3 = Color3.fromRGB(235, 98, 110), TextSize = 12, Font = Library.Font,
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, LayoutOrder = 6, ZIndex = 131,
        }, kbMenu)
        U.Corner(clr, 5)
        clr.MouseEnter:Connect(function() ctx:Tween(clr, ctx:Dur(0.12), {BackgroundTransparency = 0.45}) end)
        clr.MouseLeave:Connect(function() ctx:Tween(clr, ctx:Dur(0.12), {BackgroundTransparency = 1}) end)
        clr.MouseButton1Click:Connect(function()
            if kbTarget then kbTarget:ClearKey() end
            closeKb()
        end)
    end

    ctx:Bind(S.UIS.InputBegan, function(inp)
        if kbOpen and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if not U.PointInGui(kbMenu, inp.Position) and not U.PointInGui(kbAnchor, inp.Position) then
                closeKb()
            end
        end
    end)

    ctx.CloseKeybindMenu = closeKb
    ctx.OpenKeybindMenu = function(bindObj, anchor)
        ctx.CloseDropdown()
        ctx.CloseColorPicker()
        kbTarget, kbAnchor = bindObj, anchor
        for m, ui in pairs(kbBtns) do
            local act = (bindObj.Mode == m)
            ui.lbl.TextColor3 = act and ctx.Theme.TextWhite or ctx.Theme.TextMuted
            ui.dot.BackgroundTransparency = act and 0 or 1
        end
        showCheckDot.BackgroundColor3 = bindObj.ShowInList and ctx.Theme.Accent or Color3.fromRGB(48, 58, 76)

        local p = anchor.AbsolutePosition
        kbMenu.Position = UDim2.fromOffset(p.X, p.Y + anchor.AbsoluteSize.Y + 4)
        kbOpen = true
        U.StartFade(ctx, kbMenu, 0, 1, ctx:Dur(0.16))
    end

    -- ========================================================================
    -- HOTKEYS HUD WIDGET (С плавным перетаскиванием + анимацией выключения)
    -- ========================================================================
    local MIN_HK_W = 166
    local hkWin = U.New("Frame", {
        Name = "HotkeysWindow", Size = UDim2.fromOffset(MIN_HK_W, 32),
        Position = UDim2.new(0, 24, 0, 220), BackgroundTransparency = 1,
        Visible = ctx.Settings.HotkeysEnabled, ZIndex = 60,
    }, ctx.Gui)
    local hkScale = U.New("UIScale", {Scale = 1}, hkWin)

    local hkHeader = U.New("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ZIndex = 62,
    }, hkWin)
    U.Corner(hkHeader, 8)
    U.DarkGradient(hkHeader, Color3.fromRGB(19, 24, 36), Color3.fromRGB(9, 12, 19))
    local hkStroke = U.Stroke(hkHeader, Color3.fromRGB(44, 56, 78), 1, 0.72)

    -- Плавное перетаскивание с подъёмом и подсветкой рамки
    ctx:MakeDraggable(hkHeader, hkWin, {
        ScaleObj   = hkScale,
        LiftMult   = 1.035,
        Smoothness = 18,
        Strokes    = {hkStroke},
    })

    local hkTopLine = U.New("Frame", {
        Size = UDim2.new(1, -24, 0, 2), Position = UDim2.new(0, 12, 0, 0),
        BorderSizePixel = 0, ZIndex = 63,
    }, hkHeader)
    U.Round(hkTopLine)
    ctx:BindAccent(hkTopLine, "BackgroundColor3")
    U.New("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.25, 0.15),
            NumberSequenceKeypoint.new(0.75, 0.15),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, hkTopLine)

    local hkCountLbl
    do
        local ic = U.New("Frame", {Size = UDim2.fromOffset(20, 16), Position = UDim2.new(0, 11, 0.5, -8), BackgroundTransparency = 1, ZIndex = 63}, hkHeader)
        local base = U.New("Frame", {AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(10, 3), Position = UDim2.new(0.5, 0, 1, -1), BackgroundColor3 = Color3.fromRGB(240, 244, 252), BorderSizePixel = 0, ZIndex = 64}, ic)
        U.Corner(base, 2)
        for _, d in ipairs({
            {x = 2,  y = 11, w = 4, h = 2, r = 0},
            {x = 5,  y = 6,  w = 4, h = 2, r = 45},
            {x = 10, y = 4,  w = 2, h = 4, r = 0},
            {x = 15, y = 6,  w = 4, h = 2, r = -45},
            {x = 18, y = 11, w = 4, h = 2, r = 0},
        }) do
            local ray = U.New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(d.w, d.h),
                Position = UDim2.fromOffset(d.x, d.y), Rotation = d.r,
                BackgroundColor3 = Color3.fromRGB(240, 244, 252), BorderSizePixel = 0, ZIndex = 64,
            }, ic)
            U.Round(ray)
        end

        U.New("TextLabel", {
            Size = UDim2.new(1, -68, 1, 0), Position = UDim2.fromOffset(38, 0),
            BackgroundTransparency = 1, Text = "Hotkeys", TextColor3 = Color3.fromRGB(242, 246, 255),
            TextSize = 13, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 63,
        }, hkHeader)

        hkCountLbl = U.New("TextLabel", {
            Size = UDim2.fromOffset(22, 18), Position = UDim2.new(1, -30, 0.5, -9),
            BackgroundColor3 = Color3.fromRGB(20, 28, 44), BackgroundTransparency = 0.25,
            BorderSizePixel = 0, Text = "0", TextSize = 11, Font = Library.Font, ZIndex = 63,
        }, hkHeader)
        U.Corner(hkCountLbl, 5)
        ctx:BindAccent(hkCountLbl, "TextColor3")
    end

    local listBox = U.New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromOffset(0, 38),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 61,
    }, hkWin)
    U.New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, listBox)

    local function getBindBadge(bind)
        if bind.Mode == "Always" then return "On" end
        if bind.Mode == "Hold" then return "Hold" end
        local k = U.FormatKey(bind.InputType, bind.KeyCode)
        return (k ~= "None") and k or "On"
    end

    local function createRowEntry(bind)
        local badgeStr = getBindBadge(bind)
        local nameW    = math.ceil(S.TextService:GetTextSize(bind.Name, 13, Library.Font, Vector2.new(240, 26)).X)
        local badgeW   = math.max(30, math.ceil(S.TextService:GetTextSize(badgeStr, 10, Library.Font, Vector2.new(80, 18)).X) + 12)
        local neededW  = math.max(MIN_HK_W, 44 + nameW + badgeW + 20)

        local row = U.New("Frame", {
            Name = "HK_" .. bind.Name, Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 61,
        }, listBox)

        local card = U.New("Frame", {
            Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(-12, 0),
            BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
            BorderSizePixel = 0, ZIndex = 62,
        }, row)
        U.Corner(card, 7)
        U.DarkGradient(card, Color3.fromRGB(16, 20, 31), Color3.fromRGB(10, 13, 21))
        local cStroke = U.Stroke(card, Color3.fromRGB(40, 52, 74), 1, 1)

        local swTrack = U.New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(26, 14),
            Position = UDim2.new(0, 8, 0.5, 0), BackgroundColor3 = Color3.fromRGB(18, 24, 38),
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 63,
        }, card)
        U.Round(swTrack)

        local swGlow = U.New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16),
            Position = UDim2.new(0, 7, 0.5, 0), BackgroundColor3 = ctx.Theme.Accent,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 63,
        }, swTrack)
        U.Round(swGlow)

        local swKnob = U.New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10),
            Position = UDim2.new(0, 7, 0.5, 0), BackgroundColor3 = Color3.fromRGB(120, 132, 152),
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 64,
        }, swTrack)
        U.Round(swKnob)

        local lbl = U.New("TextLabel", {
            Size = UDim2.new(1, -(48 + badgeW), 1, 0), Position = UDim2.fromOffset(42, 0),
            BackgroundTransparency = 1, Text = bind.Name, TextColor3 = Color3.fromRGB(240, 244, 252),
            TextTransparency = 1, TextSize = 12, Font = Library.Font,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 63,
        }, card)

        local badge = U.New("TextLabel", {
            AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(badgeW, 18),
            Position = UDim2.new(1, -7, 0.5, 0), BackgroundColor3 = Color3.fromRGB(20, 28, 44),
            BackgroundTransparency = 1, BorderSizePixel = 0, Text = badgeStr,
            TextColor3 = ctx.Theme.Accent, TextTransparency = 1, TextSize = 10, Font = Library.Font, ZIndex = 63,
        }, card)
        U.Corner(badge, 4)

        return {
            Row = row, Card = card, CardStroke = cStroke,
            SwTrack = swTrack, SwGlow = swGlow, SwKnob = swKnob,
            Label = lbl, Badge = badge, NeededW = neededW,
            Exiting = false, Token = 0,
        }
    end

    local function syncWidgetLayout()
        local maxW, activeCount, visibleAny = MIN_HK_W, 0, false
        for b, e in pairs(ctx.HotkeyRows) do
            if e.Row and e.Row.Parent then
                visibleAny = true
                if not e.Exiting then
                    activeCount += 1
                    e.Badge.Text       = getBindBadge(b)
                    e.Badge.TextColor3 = ctx.Theme.Accent
                    if e.NeededW > maxW then maxW = e.NeededW end
                end
            end
        end

        hkCountLbl.Text = tostring(activeCount)
        ctx:Tween(hkWin, ctx:Dur(0.24), {Size = UDim2.fromOffset(maxW, 32)})

        local want = ctx.Settings.HotkeysEnabled and (visibleAny or ctx.MenuOpen)
        if want ~= ctx.HotkeysShown then
            ctx.HotkeysShown = want
            U.StartFade(ctx, hkWin, want and 0 or 1, want and 1 or 0, ctx:Dur(want and 0.22 or 0.18))
        end
    end

    local function animateRowEnter(e)
        e.Exiting = false
        e.Token  += 1
        local myTok = e.Token
        local d = ctx:Dur(0.22)
        ctx:Tween(e.Row, d, {Size = UDim2.new(1, 0, 0, 28)})
        ctx:Tween(e.Card, d, {Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 0.14})
        ctx:Tween(e.CardStroke, d, {Transparency = 0.74})
        ctx:Tween(e.SwTrack, d, {BackgroundColor3 = ctx.Theme.AccentDim, BackgroundTransparency = 0})
        ctx:Tween(e.SwGlow, ctx:Dur(0.24), {
            Position = UDim2.new(1, -7, 0.5, 0),
            BackgroundColor3 = ctx.Theme.Accent,
            BackgroundTransparency = 0.7,
        })
        ctx:Tween(e.SwKnob, ctx:Dur(0.14), {
            Position = UDim2.new(1, -7, 0.5, 0),
            Size = UDim2.fromOffset(14, 9),
            BackgroundColor3 = ctx.Theme.Accent,
            BackgroundTransparency = 0,
        })
        task.delay(ctx:Dur(0.11), function()
            if e.Token == myTok and not e.Exiting and e.SwKnob and e.SwKnob.Parent then
                ctx:Tween(e.SwKnob, ctx:Dur(0.18), {Size = UDim2.fromOffset(10, 10)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
        end)
        ctx:Tween(e.Label, d, {TextColor3 = Color3.fromRGB(240, 244, 252), TextTransparency = 0})
        ctx:Tween(e.Badge, d, {BackgroundTransparency = 0.25, TextTransparency = 0})
    end

    local function animateRowExit(bind, e)
        if e.Exiting then return end
        e.Exiting = true
        e.Token  += 1
        local myTok = e.Token

        -- Шаг 1: Анимация ВЫКЛЮЧЕНИЯ тумблера (растягивается, уходит влево, гаснет)
        local offD = ctx:Dur(0.18)
        ctx:Tween(e.SwTrack, offD, {BackgroundColor3 = Color3.fromRGB(18, 24, 38)})
        ctx:Tween(e.SwGlow, offD, {Position = UDim2.new(0, 7, 0.5, 0), BackgroundTransparency = 1})
        ctx:Tween(e.SwKnob, offD * 0.65, {
            Position = UDim2.new(0, 7, 0.5, 0),
            Size = UDim2.fromOffset(14, 9),
            BackgroundColor3 = Color3.fromRGB(72, 84, 106),
        })
        task.delay(offD * 0.55, function()
            if e.Token == myTok and e.SwKnob and e.SwKnob.Parent then
                ctx:Tween(e.SwKnob, ctx:Dur(0.12), {Size = UDim2.fromOffset(10, 10)})
            end
        end)
        ctx:Tween(e.Label, offD, {TextColor3 = Color3.fromRGB(130, 142, 162)})
        ctx:Tween(e.Badge, offD, {TextTransparency = 0.55})

        -- Шаг 2: Строка плавно уезжает, затухает и схлопывается
        task.delay(offD * 0.72, function()
            if e.Token ~= myTok or not e.Row or not e.Row.Parent then return end
            local fadeD = ctx:Dur(0.22)
            ctx:Tween(e.Card, fadeD, {Position = UDim2.fromOffset(-14, 0), BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            ctx:Tween(e.CardStroke, fadeD, {Transparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            ctx:Tween(e.SwTrack, fadeD, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            ctx:Tween(e.SwKnob, fadeD, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            ctx:Tween(e.Label, fadeD, {TextTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            ctx:Tween(e.Badge, fadeD, {BackgroundTransparency = 1, TextTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

            local colTw = ctx:Tween(e.Row, fadeD, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
            if colTw then
                colTw.Completed:Connect(function()
                    if e.Token == myTok and e.Exiting then
                        if ctx.HotkeyRows[bind] == e then ctx.HotkeyRows[bind] = nil end
                        if e.Row and e.Row.Parent then e.Row:Destroy() end
                        syncWidgetLayout()
                    end
                end)
            end
        end)
    end

    table.insert(ctx.AccentCbs, function()
        for _, e in pairs(ctx.HotkeyRows) do
            if not e.Exiting and e.Row and e.Row.Parent then
                local d = ctx:Dur(0.2)
                ctx:Tween(e.SwTrack, d, {BackgroundColor3 = ctx.Theme.AccentDim})
                ctx:Tween(e.SwGlow, d, {BackgroundColor3 = ctx.Theme.Accent})
                ctx:Tween(e.SwKnob, d, {BackgroundColor3 = ctx.Theme.Accent})
                ctx:Tween(e.Badge, d, {TextColor3 = ctx.Theme.Accent})
            end
        end
    end)

    ctx.HotkeysWindow = hkWin
    ctx.RefreshHotkeys = function()
        for _, b in ipairs(ctx.Binds) do
            local shouldShow = b.ShowInList and b.GetState() and (b.KeyCode ~= nil or b.InputType ~= nil or b.Mode == "Always")
            local entry = ctx.HotkeyRows[b]
            if shouldShow then
                if not entry then
                    entry = createRowEntry(b)
                    ctx.HotkeyRows[b] = entry
                    animateRowEnter(entry)
                elseif entry.Exiting then
                    animateRowEnter(entry)
                end
            elseif entry and not entry.Exiting then
                animateRowExit(b, entry)
            end
        end
        syncWidgetLayout()
    end
end

-- ============================================================================
-- МОДУЛЬ 4: WATERMARK (ИСПРАВЛЕННАЯ ШИРИНА БЕЗ БЕСКОНЕЧНОЙ ПОЛОСЫ + DRAG ANIM)
-- ============================================================================
function U.BuildWatermark(ctx)
    local NL_W, GAP = 44, 7

    local wmRoot = U.New("Frame", {
        Name = "WatermarkFrame",
        AnchorPoint = Vector2.new(1, 0),
        Size = UDim2.fromOffset(300, 32),
        Position = UDim2.new(1, -18, 0, 14),
        BackgroundTransparency = 1,
        Visible = ctx.Settings.Watermark,
        ZIndex = 70,
    }, ctx.Gui)
    local wmScale = U.New("UIScale", {Scale = 1}, wmRoot)

    -- Капсула 1: [ NL ]
    local nlPill = U.New("Frame", {
        Size = UDim2.fromOffset(NL_W, 32),
        Position = UDim2.fromOffset(0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ZIndex = 72,
    }, wmRoot)
    U.Corner(nlPill, 8)
    U.DarkGradient(nlPill, Color3.fromRGB(20, 26, 40), Color3.fromRGB(9, 12, 19))
    local nlStroke = U.Stroke(nlPill, Color3.fromRGB(48, 62, 86), 1, 0.7)

    do
        local nlGlow = U.New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(26, 16),
            Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 0.85,
            BorderSizePixel = 0, ZIndex = 72,
        }, nlPill)
        U.Round(nlGlow)
        ctx:BindAccent(nlGlow, "BackgroundColor3")

        local c = U.New("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0), Position = UDim2.fromOffset(-1, -1),
            BackgroundTransparency = 1, Text = "NL", TextSize = 16, Font = Library.LogoFont, ZIndex = 73,
        }, nlPill)
        ctx:BindAccent(c, "TextColor3")
        U.New("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "NL",
            TextColor3 = Color3.new(1, 1, 1), TextSize = 16, Font = Library.LogoFont, ZIndex = 74,
        }, nlPill)
    end

    -- Капсула 2: [ User | Ping | FPS | Time ] — БЕЗ AutomaticSize на родителе тени!
    local infoPill = U.New("Frame", {
        Size = UDim2.fromOffset(240, 32),
        Position = UDim2.fromOffset(NL_W + GAP, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ZIndex = 72,
    }, wmRoot)
    U.Corner(infoPill, 8)
    U.DarkGradient(infoPill, Color3.fromRGB(20, 26, 40), Color3.fromRGB(9, 12, 19))
    local infoStroke = U.Stroke(infoPill, Color3.fromRGB(48, 62, 86), 1, 0.7)

    -- Плавное перетаскивание за любую из двух капсул Watermark
    ctx:MakeDraggable({nlPill, infoPill}, wmRoot, {
        ScaleObj   = wmScale,
        LiftMult   = 1.035,
        Smoothness = 18,
        Strokes    = {nlStroke, infoStroke},
    })

    -- Внутренний контейнер только для контента (тень лежит снаружи него)
    local contentBox = U.New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 73,
    }, infoPill)
    U.New("UIPadding", {PaddingLeft = UDim.new(0, 13), PaddingRight = UDim.new(0, 13)}, contentBox)
    local contentLayout = U.New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
    }, contentBox)

    local function syncWmWidth(instant)
        local contentW = math.ceil(contentLayout.AbsoluteContentSize.X)
        if contentW <= 0 then return end
        local infoW  = contentW + 26
        local totalW = NL_W + GAP + infoW
        if instant then
            infoPill.Size = UDim2.fromOffset(infoW, 32)
            wmRoot.Size   = UDim2.fromOffset(totalW, 32)
        else
            ctx:Tween(infoPill, ctx:Dur(0.18), {Size = UDim2.fromOffset(infoW, 32)}, Enum.EasingStyle.Quart)
            ctx:Tween(wmRoot,   ctx:Dur(0.18), {Size = UDim2.fromOffset(totalW, 32)}, Enum.EasingStyle.Quart)
        end
    end
    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        syncWmWidth(false)
    end)

    local function divider(order)
        U.New("Frame", {
            Size = UDim2.fromOffset(1, 13), BackgroundColor3 = Color3.fromRGB(52, 66, 92),
            BackgroundTransparency = 0.45, BorderSizePixel = 0, LayoutOrder = order, ZIndex = 74,
        }, contentBox)
    end

    local function seg(order, iconW)
        local s = U.New("Frame", {
            AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20),
            BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 74,
        }, contentBox)
        U.New("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
        }, s)
        local ic = U.New("Frame", {Size = UDim2.fromOffset(iconW, 14), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 75}, s)
        local lb = U.New("TextLabel", {
            AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20),
            BackgroundTransparency = 1, RichText = true,
            TextColor3 = Color3.fromRGB(240, 244, 252),
            TextSize = 12, Font = Library.Font, LayoutOrder = 2, ZIndex = 75,
        }, s)
        return ic, lb
    end

    do
        local ic, lb = seg(1, 14)
        lb.Text = ctx.LocalPlayer.Name
        local userImg = U.New("ImageLabel", {
            Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1,
            Image = Library.Icons.Players, ZIndex = 76,
        }, ic)
        ctx:BindAccent(userImg, "ImageColor3")
    end

    divider(2)

    local pingLbl, fpsLbl, timeLbl
    do
        local ic; ic, pingLbl = seg(3, 14)
        pingLbl.Text = '0 <font color="#8A9AB5">ms</font>'
        for i = 1, 4 do
            local h = 3 + i * 2
            local bar = U.New("Frame", {
                Size = UDim2.fromOffset(2, h), Position = UDim2.fromOffset((i - 1) * 4, 13 - h),
                BorderSizePixel = 0, ZIndex = 76,
            }, ic)
            U.Round(bar); ctx:BindAccent(bar, "BackgroundColor3")
        end
    end

    divider(4)

    do
        local ic; ic, fpsLbl = seg(5, 13)
        fpsLbl.Text = '60 <font color="#8A9AB5">fps</font>'
        for i, h in ipairs({7, 12, 9}) do
            local bar = U.New("Frame", {
                Size = UDim2.fromOffset(2, h), Position = UDim2.fromOffset(1 + (i - 1) * 4, 13 - h),
                BorderSizePixel = 0, ZIndex = 76,
            }, ic)
            U.Round(bar); ctx:BindAccent(bar, "BackgroundColor3")
        end
    end

    divider(6)

    do
        local ic; ic, timeLbl = seg(7, 14)
        timeLbl.Text = os.date("%H:%M")
        local dial = U.New("Frame", {Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, ZIndex = 76}, ic)
        U.Round(dial)
        ctx:BindAccent(U.Stroke(dial, ctx.Theme.Accent, 1.5, 0), "Color")
