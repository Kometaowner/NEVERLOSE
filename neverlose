function U.BuildConfigPage(ctx, tab)
    U.Storage.EnsureFolders()

    local topBar = U.New("Frame", {
        Name = "ConfigsTopActions", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Visible = false, ZIndex = 14,
    }, ctx.TopActionsHost)

    local saveTopBtn = U.MakeOutlineButton(ctx, topBar, "Save", 96, 32, UDim2.new(0, 6, 0.5, -16), false, "save", 15)
    local createTopBtn = U.MakeAccentButton(ctx, topBar, "Create", 122, 32, UDim2.new(0, 114, 0.5, -16), "plus", 15)
    local countBadge = U.New("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(92, 24),
        Position = UDim2.new(1, -6, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(13, 18, 30), BackgroundTransparency = 0.2,
        BorderSizePixel = 0, Text = "0 configs", TextColor3 = ctx.Theme.TextMuted,
        TextSize = 11, Font = Library.Font, ZIndex = 15,
    }, topBar)
    U.Corner(countBadge, 6)
    U.Stroke(countBadge, ctx.Theme.Border, 1, 0.55)

    local page = U.New("ScrollingFrame", {
        Name = "ConfigsPage", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false, ZIndex = 13,
    }, ctx.PagesHost)
    ctx:BindAccent(page, "ScrollBarImageColor3")
    table.insert(ctx.AllPages, page)

    local collapsed = false
    local secBtn = U.New("TextButton", {
        Size = UDim2.new(1, -38, 0, 26), Position = UDim2.fromOffset(16, 12),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 14,
    }, page)
    U.New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(9, 1.5),
        Position = UDim2.new(0, 2, 0.5, 0), BackgroundColor3 = ctx.Theme.TextMuted,
        BorderSizePixel = 0, ZIndex = 15,
    }, secBtn)
    local secPlusV = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(1.5, 9),
        Position = UDim2.new(0, 6, 0.5, 0), BackgroundColor3 = ctx.Theme.TextMuted,
        BorderSizePixel = 0, Visible = false, ZIndex = 15,
    }, secBtn)
    U.New("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(18, 0),
        BackgroundTransparency = 1, Text = "My Items", TextColor3 = Color3.fromRGB(220, 228, 240),
        TextSize = 13, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 15,
    }, secBtn)
    U.New("Frame", {
        Size = UDim2.new(1, -38, 0, 1), Position = UDim2.fromOffset(16, 42),
        BackgroundColor3 = ctx.Theme.Border, BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 14,
    }, page)

    local listHolder = U.New("Frame", {
        Size = UDim2.new(1, -38, 0, 0), Position = UDim2.fromOffset(16, 54),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 14,
    }, page)
    U.New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 9)}, listHolder)

    secBtn.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        secPlusV.Visible = collapsed
        listHolder.Visible = not collapsed
    end)

    local function captureState()
        local values = {}
        for _, rec in ipairs(ctx.ConfigRegistry) do
            local ok, val = pcall(rec.get)
            if ok then values[rec.id] = val end
        end
        return {
            Accent = U.ColorToHex(ctx.Theme.Accent),
            Settings = {
                Watermark      = ctx.Settings.Watermark,
                HotkeysEnabled = ctx.Settings.HotkeysEnabled,
                MenuScale      = ctx.Settings.MenuScale,
                EspScale       = ctx.Settings.EspScale,
                AnimSpeed      = ctx.Settings.AnimSpeed,
            },
            Values = values,
        }
    end

    local function applyState(data)
        if type(data) ~= "table" then return end
        if data.Accent then
            local c = U.HexToColor(data.Accent)
            if c then ctx:SetAccent(c) end
        end
        if type(data.Settings) == "table" then
            if data.Settings.AnimSpeed then ctx.Settings.AnimSpeed = data.Settings.AnimSpeed end
            if data.Settings.MenuScale then
                ctx.Settings.MenuScale = data.Settings.MenuScale
                if ctx.MenuOpen then ctx:Tween(ctx.MainScale, ctx:Dur(0.2), {Scale = ctx.Settings.MenuScale}) end
            end
            if data.Settings.EspScale then ctx.Settings.EspScale = data.Settings.EspScale end
        end
        if type(data.Values) == "table" then
            for id, val in pairs(data.Values) do
                local rec = ctx.ConfigMap[id]
                if rec then pcall(rec.set, val) end
            end
        end
        ctx.RefreshHotkeys()
    end

    local function persistConfig(cfg)
        U.Storage.MemConfigs[cfg.Name] = cfg
        U.Storage.SaveJson("NeverloseUI/Configs/" .. U.Storage.FileKey(cfg.Name) .. ".json", cfg)
    end

    local function loadAllConfigs()
        ctx.Configs = {}
        if U.Storage.HasFS() and type(listfiles) == "function" then
            local ok, files = pcall(listfiles, "NeverloseUI/Configs")
            if ok and type(files) == "table" then
                for _, path in ipairs(files) do
                    if string.sub(path, -5) == ".json" then
                        local data = U.Storage.ReadJson(path)
                        if data and data.Name then
                            table.insert(ctx.Configs, data)
                        end
                    end
                end
            end
        end
        if #ctx.Configs == 0 then
            local starter = {
                Name     = "default",
                Author   = ctx.LocalPlayer.Name,
                Modified = U.Storage.NowStr(),
                Data     = captureState(),
            }
            table.insert(ctx.Configs, starter)
            ctx.ActiveConfig = starter.Name
            persistConfig(starter)
        end
    end

    local cfgMetaLabels = {}
    table.insert(ctx.AccentCbs, function(col)
        local h = U.ColorToHex(col)
        for _, m in ipairs(cfgMetaLabels) do
            if m.lbl and m.lbl.Parent then
                m.lbl.Text = string.format('Modified: <font color="%s">%s</font>   Author: <font color="%s">%s</font>', h, m.item.Modified or "", h, m.item.Author or ctx.LocalPlayer.Name)
            end
        end
    end)

    local rebuildList
    rebuildList = function()
        table.clear(cfgMetaLabels)
        for _, ch in ipairs(listHolder:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end

        countBadge.Text = tostring(#ctx.Configs) .. ((#ctx.Configs == 1) and " config" or " configs")
        for idx, cfg in ipairs(ctx.Configs) do
            local isActive = (ctx.ActiveConfig == cfg.Name)
            local card = U.New("Frame", {
                Size = UDim2.new(1, 0, 0, 66),
                BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                LayoutOrder = idx, ZIndex = 15,
            }, listHolder)
            U.Corner(card, 8)
            U.DarkGradient(
                card,
                isActive and Color3.fromRGB(15, 22, 38) or Color3.fromRGB(12, 17, 28),
                isActive and Color3.fromRGB(10, 15, 26) or Color3.fromRGB(8, 12, 20)
            )
            local cStroke = U.Stroke(card, isActive and ctx.Theme.Accent or Color3.fromRGB(26, 37, 56), 1, isActive and 0.32 or 0.48)
            if isActive then
                ctx:BindAccent(cStroke, "Color")
                local accentBar = U.New("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(3, 34),
                    Position = UDim2.new(0, 0, 0.5, 0), BorderSizePixel = 0, ZIndex = 17,
                }, card)
                U.Round(accentBar)
                ctx:BindAccent(accentBar, "BackgroundColor3")
            end

            local nameX = isActive and 18 or 16
            local nameLbl = U.New("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.X,
                Size = UDim2.new(0, 0, 0, 20), Position = UDim2.fromOffset(nameX, 11),
                BackgroundTransparency = 1, Text = cfg.Name, TextColor3 = Color3.fromRGB(246, 249, 255),
                TextSize = 14, Font = Enum.Font.GothamSemibold, TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 16,
            }, card)

            if isActive then
                local nameW = math.min(220, math.ceil(S.TextService:GetTextSize(cfg.Name, 14, Enum.Font.GothamSemibold, Vector2.new(260, 20)).X))
                local pill = U.New("TextLabel", {
                    Size = UDim2.fromOffset(50, 16), Position = UDim2.fromOffset(nameX + nameW + 8, 13),
                    BackgroundColor3 = ctx.Theme.AccentDim, BorderSizePixel = 0,
                    Text = "ACTIVE", TextSize = 9, Font = Enum.Font.GothamBold, ZIndex = 16,
                }, card)
                U.Corner(pill, 4)
                ctx:BindDim(pill, "BackgroundColor3")
                ctx:BindAccent(pill, "TextColor3")
            end

            local accHex = U.ColorToHex(ctx.Theme.Accent)
            local metaLbl = U.New("TextLabel", {
                Size = UDim2.new(1, -184, 0, 18), Position = UDim2.fromOffset(16, 35),
                BackgroundTransparency = 1, RichText = true,
                Text = string.format('Modified: <font color="%s">%s</font>   Author: <font color="%s">%s</font>', accHex, cfg.Modified or "", accHex, cfg.Author or ctx.LocalPlayer.Name),
                TextColor3 = Color3.fromRGB(145, 158, 180), TextSize = 12, Font = Library.Font,
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 16,
            }, card)
            table.insert(cfgMetaLabels, {lbl = metaLbl, item = cfg})

            U.DrawDotsButton(ctx, card, UDim2.new(1, -150, 0.5, -14), 16, function(anchor)
                ctx.OpenContextMenu(anchor, {
                    {
                        Label = "Rename",
                        OnClick = function()
                            ctx.OpenInputModal({
                                Title = "Rename Config", Label = "New Name", Default = cfg.Name, ConfirmText = "Rename",
                                OnConfirm = function(newName)
                                    if newName == cfg.Name then return end
                                    U.Storage.DeleteFile("NeverloseUI/Configs/" .. U.Storage.FileKey(cfg.Name) .. ".json")
                                    if ctx.ActiveConfig == cfg.Name then ctx.ActiveConfig = newName end
                                    cfg.Name = newName
                                    cfg.Modified = U.Storage.NowStr()
                                    persistConfig(cfg)
                                    task.defer(rebuildList)
                                    ctx.Notify("Configs", "Renamed to " .. newName, "success")
                                end,
                            })
                        end,
                    },
                    {
                        Label = "Share / Export",
                        OnClick = function()
                            local ok, raw = pcall(function() return S.HttpService:JSONEncode(cfg) end)
                            if ok then ctx.OpenShareModal("Export Config — " .. cfg.Name, "NL_CFG:" .. raw) end
                        end,
                    },
                    {
                        Label = "Duplicate",
                        OnClick = function()
                            local copy = {
                                Name     = cfg.Name .. "_copy",
                                Author   = ctx.LocalPlayer.Name,
                                Modified = U.Storage.NowStr(),
                                Data     = cfg.Data,
                            }
                            table.insert(ctx.Configs, 1, copy)
                            persistConfig(copy)
                            task.defer(rebuildList)
                            ctx.Notify("Configs", "Duplicated " .. cfg.Name, "success")
                        end,
                    },
                    {Divider = true},
                    {
                        Label = "Delete", Danger = true,
                        OnClick = function()
                            U.Storage.DeleteFile("NeverloseUI/Configs/" .. U.Storage.FileKey(cfg.Name) .. ".json")
                            if ctx.ActiveConfig == cfg.Name then ctx.ActiveConfig = nil end
                            for k, v in ipairs(ctx.Configs) do
                                if v == cfg then table.remove(ctx.Configs, k) break end
                            end
                            task.defer(rebuildList)
                            ctx.Notify("Configs", "Deleted " .. cfg.Name, "error")
                        end,
                    },
                })
            end)

            local actBtn
            if isActive then
                actBtn = U.MakeOutlineButton(ctx, card, "Save", 104, 30, UDim2.new(1, -116, 0.5, -15), true, "save", 16)
            else
                actBtn = U.MakeAccentButton(ctx, card, "Load", 104, 30, UDim2.new(1, -116, 0.5, -15), "download", 16)
            end

            card.MouseEnter:Connect(function()
                if not isActive then ctx:Tween(cStroke, ctx:Dur(0.14), {Color = Color3.fromRGB(42, 60, 92), Transparency = 0.2}) end
            end)
            card.MouseLeave:Connect(function()
                if not isActive then ctx:Tween(cStroke, ctx:Dur(0.14), {Color = Color3.fromRGB(24, 34, 52), Transparency = 0.45}) end
            end)

            actBtn.MouseButton1Click:Connect(function()
                if isActive then
                    cfg.Data = captureState()
                    cfg.Modified = U.Storage.NowStr()
                    persistConfig(cfg)
                    ctx.Notify("Configs", "Saved '" .. cfg.Name .. "'", "success")
                else
                    ctx.ActiveConfig = cfg.Name
                    applyState(cfg.Data)
                    ctx.Notify("Configs", "Loaded '" .. cfg.Name .. "'", "success")
                end
                task.defer(rebuildList)
            end)
        end
    end

    local function openCreateConfigModal()
        ctx.OpenInputModal({
            Title = "Create / Import Config",
            Label = "Config Name",
            Placeholder = "e.g. legit_main",
            ExtraLabel = "Import Code (optional — paste NL_CFG:...)",
            ExtraPlaceholder = "Leave empty to save current settings...",
            ConfirmText = "Create",
            OnConfirm = function(name, importStr)
                local cfgData = captureState()
                local author = ctx.LocalPlayer.Name
                if importStr and #importStr > 7 then
                    local raw = importStr:gsub("^%s*NL_CFG:", "")
                    local ok, parsed = pcall(function() return S.HttpService:JSONDecode(raw) end)
                    if ok and type(parsed) == "table" and type(parsed.Data) == "table" then
                        cfgData = parsed.Data
                        if parsed.Author then author = parsed.Author end
                    end
                end
                local cfg = {
                    Name     = name,
                    Author   = author,
                    Modified = U.Storage.NowStr(),
                    Data     = cfgData,
                }
                table.insert(ctx.Configs, 1, cfg)
                ctx.ActiveConfig = cfg.Name
                persistConfig(cfg)
                task.defer(rebuildList)
                ctx.Notify("Configs", "Created '" .. name .. "'", "success")
            end,
        })
    end

    saveTopBtn.MouseButton1Click:Connect(function()
        for _, cfg in ipairs(ctx.Configs) do
            if cfg.Name == ctx.ActiveConfig then
                cfg.Data = captureState()
                cfg.Modified = U.Storage.NowStr()
                persistConfig(cfg)
                task.defer(rebuildList)
                ctx.Notify("Configs", "Saved '" .. cfg.Name .. "'", "success")
                return
            end
        end
        openCreateConfigModal()
    end)
    createTopBtn.MouseButton1Click:Connect(openCreateConfigModal)

    tab.TopActionBar = topBar
    tab.CustomPage   = page
    loadAllConfigs()
    rebuildList()
end


-- ============================================================================
-- ПУБЛИЧНЫЙ ВХОД БИБЛИОТЕКИ: Library:CreateWindow(options)
-- ============================================================================
function Library:CreateWindow(opts)
    local parent = U.GetGuiParent()
    local old = parent:FindFirstChild("NeverloseUI")
    if old then old:Destroy() end

    local ctx = U.CreateContext(opts)
    ctx.Gui = U.New("ScreenGui", {
        Name = "NeverloseUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 500,
    }, parent)

    ctx.Gui.Destroying:Connect(function()
        for _, c in ipairs(ctx.Connections) do
            if c.Connected then c:Disconnect() end
        end
    end)

    task.spawn(function()
        local ok, img = pcall(function()
            return S.Players:GetUserThumbnailAsync(ctx.LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        if ok and img then
            ctx.AvatarThumb = img
            for _, l in ipairs(ctx.AvatarLabels) do
                if l and l.Parent then l.Image = img end
            end
        end
    end)

    U.BuildMainWindow(ctx)
    U.BuildDropdownOverlay(ctx)
    U.BuildColorPicker(ctx)
    U.BuildKeybindAndHotkeys(ctx)
    U.BuildWatermark(ctx)
    U.BuildSearchPopup(ctx)
    U.BuildAboutWindow(ctx)
    U.BuildNotifications(ctx)
    U.BuildContextMenu(ctx)
    U.BuildModals(ctx)

    local toggleKey = (opts and opts.ToggleKey) or Enum.KeyCode.Insert

    local function setMenuOpen(open)
        if ctx.MenuOpen == open then return end
        ctx.MenuOpen = open
        ctx:CancelAllDrags()
        ctx.CloseDropdown()
        ctx.CloseColorPicker()
        ctx.CloseKeybindMenu()
        ctx.CloseSearch()
        ctx.CloseContextMenu()

        for _, p in ipairs(ctx.AllPages) do
            U.FinishFade(ctx, p)
            p.Visible = (p == ctx.CurPage)
            if p.Visible then p.Position = UDim2.new(0, 0, 0, 0) end
        end

        ctx.MenuAnimToken = (ctx.MenuAnimToken or 0) + 1
        local myTok = ctx.MenuAnimToken

        if open then
            local rest = ctx.MenuRestPos or ctx.MainFrame.Position
            ctx.MenuRestPos = rest
            ctx.MainFrame.Position = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset + 14)
            ctx.MainScale.Scale = ctx.Settings.MenuScale * 0.92
            ctx:Tween(ctx.MainFrame, ctx:Dur(0.32), {Position = rest}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            ctx:Tween(ctx.MainScale, ctx:Dur(0.32), {Scale = ctx.Settings.MenuScale}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            U.StartFade(ctx, ctx.MainFrame, 0, 1, ctx:Dur(0.25))
            if ctx.MainStroke then
                ctx.MainStroke.Color = ctx.Theme.Accent
                ctx.MainStroke.Transparency = 0.2
                task.delay(ctx:Dur(0.14), function()
                    if ctx.MenuAnimToken == myTok and ctx.MainStroke and ctx.MainStroke.Parent then
                        ctx:Tween(ctx.MainStroke, ctx:Dur(0.38), {Color = ctx.Theme.Border, Transparency = 0.45}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                    end
                end)
            end
        else
            if ctx.AboutOpen then ctx.SetAboutOpen(false) end
            local rest = ctx.MainFrame.Position
            ctx.MenuRestPos = rest
            local dropPos = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset + 10)
            ctx:Tween(ctx.MainFrame, ctx:Dur(0.20), {Position = dropPos}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            ctx:Tween(ctx.MainScale, ctx:Dur(0.20), {Scale = ctx.Settings.MenuScale * 0.93}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            U.StartFade(ctx, ctx.MainFrame, 1, 0, ctx:Dur(0.19), function()
                if ctx.MenuAnimToken == myTok and not ctx.MenuOpen and ctx.MainFrame and ctx.MainFrame.Parent then
                    ctx.MainFrame.Position = rest
                end
            end)
        end
        ctx.RefreshHotkeys()
    end

    -- RenderStepped: Fade-движок + инерционное перетаскивание + сглаженные метрики Watermark
    do
        local wmT, smoothFps = 0, 60
        ctx:Bind(S.RunService.RenderStepped, function(dt)
            U.StepFades(ctx, dt)
            ctx:StepDrags(dt)
            if dt > 0 then
                smoothFps = smoothFps * 0.9 + (1 / dt) * 0.1
            end
            wmT += dt
            if wmT >= 0.4 then
                local ping = 0
                pcall(function() ping = math.floor(S.Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
                ctx.WmLabels.Ping.Text = tostring(ping) .. ' <font color="#8A9AB5">ms</font>'
                ctx.WmLabels.Fps.Text  = tostring(math.floor(smoothFps + 0.5)) .. ' <font color="#8A9AB5">fps</font>'
                ctx.WmLabels.Time.Text = os.date("%H:%M")
                wmT = 0
            end
        end)
    end

    ctx:Bind(S.UIS.InputBegan, function(inp)
        if S.UIS:GetFocusedTextBox() then return end
        if ctx.ListeningBind then
            local b = ctx.ListeningBind; ctx.ListeningBind = nil
            if inp.KeyCode == Enum.KeyCode.Escape then
                b:UpdateChip()
            elseif inp.KeyCode == Enum.KeyCode.Backspace or inp.KeyCode == Enum.KeyCode.Delete then
                b:ClearKey()
            elseif inp.UserInputType == Enum.UserInputType.Keyboard then
                b.KeyCode, b.InputType = inp.KeyCode, nil; b:UpdateChip()
            elseif inp.UserInputType == Enum.UserInputType.MouseButton2 or inp.UserInputType == Enum.UserInputType.MouseButton3 then
                b.KeyCode, b.InputType = nil, inp.UserInputType; b:UpdateChip()
            else
                b:UpdateChip()
            end
            return
        end
        if inp.KeyCode == toggleKey then setMenuOpen(not ctx.MenuOpen) return end
        for _, b in ipairs(ctx.Binds) do
            if (b.KeyCode and inp.KeyCode == b.KeyCode) or (b.InputType and inp.UserInputType == b.InputType) then
                if b.Mode == "Toggle" then b:SetState(not b.GetState())
                elseif b.Mode == "Hold" then b:SetState(true) end
            end
        end
    end)

    ctx:Bind(S.UIS.InputEnded, function(inp)
        for _, b in ipairs(ctx.Binds) do
            if b.Mode == "Hold" and ((b.KeyCode and inp.KeyCode == b.KeyCode) or (b.InputType and inp.UserInputType == b.InputType)) then
                b:SetState(false)
            end
        end
    end)

    local Window = { Settings = ctx.Settings, Theme = ctx.Theme }

    function ctx:ReflowSidebar()
        local y = 2
        local hasLuaTabs = false
        for _, it in ipairs(self.SidebarItems) do
            if it.kind == "Tab" and it.tab.IsLua then hasLuaTabs = true break end
        end
        for _, it in ipairs(self.SidebarItems) do
            if it.kind == "Category" then
                local vis = (not it.isLuaCat) or hasLuaTabs
                it.inst.Visible = vis
                if vis then
                    if y > 4 then y += 6 end
                    it.inst.Position = UDim2.fromOffset(16, y)
                    y += 24
                end
            elseif it.kind == "Tab" then
                it.tab.PosY = y
                it.inst.Position = UDim2.fromOffset(10, y)
                y += 36
            end
        end
        self.SidebarY = y
        self.MenuScroll.CanvasSize = UDim2.new(0, 0, 0, y + 10)
        if self.ActiveTab and self.TabSlider.Visible then
            self:Tween(self.TabSlider, self:Dur(0.18), {Position = UDim2.fromOffset(10, self.ActiveTab.PosY)})
        end
    end

    function Window:AddCategory(name, isLuaCat)
        ctx.CurCategory = name
        local lbl = U.New("TextLabel", {
            Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(16, ctx.SidebarY),
            BackgroundTransparency = 1, Text = name, TextColor3 = ctx.Theme.TextCategory,
            TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 15,
        }, ctx.MenuScroll)
        local entry = {kind = "Category", inst = lbl, name = name, isLuaCat = isLuaCat == true}
        table.insert(ctx.SidebarItems, entry)
        ctx:ReflowSidebar()
        return entry
    end

    function Window:RemoveTab(tabObj)
        if not tabObj then return end
        local wasActive = (ctx.ActiveTab == tabObj)
        for i = #ctx.SidebarItems, 1, -1 do
            if ctx.SidebarItems[i].tab == tabObj then table.remove(ctx.SidebarItems, i) end
        end
        for i = #ctx.Tabs, 1, -1 do
            if ctx.Tabs[i] == tabObj then table.remove(ctx.Tabs, i) end
        end
        for i = #ctx.SearchList, 1, -1 do
            if ctx.SearchList[i].Tab == tabObj then table.remove(ctx.SearchList, i) end
        end
        for i = #ctx.Binds, 1, -1 do
            local b = ctx.Binds[i]
            if b.Tab == tabObj then
                local rowE = ctx.HotkeyRows[b]
                if rowE and rowE.Row and rowE.Row.Parent then rowE.Row:Destroy() end
                ctx.HotkeyRows[b] = nil
                table.remove(ctx.Binds, i)
            end
        end
        for i = #ctx.ConfigRegistry, 1, -1 do
            if ctx.ConfigRegistry[i].tab == tabObj then
                ctx.ConfigMap[ctx.ConfigRegistry[i].id] = nil
                table.remove(ctx.ConfigRegistry, i)
            end
        end
        for _, sub in ipairs(tabObj.Subtabs) do
            for i = #ctx.AllPages, 1, -1 do
                if ctx.AllPages[i] == sub.Page then table.remove(ctx.AllPages, i) end
            end
            if sub.Page and sub.Page.Parent then sub.Page:Destroy() end
        end
        if tabObj.Button and tabObj.Button.Parent then tabObj.Button:Destroy() end
        if tabObj.SubBar and tabObj.SubBar.Parent then tabObj.SubBar:Destroy() end
        ctx:ReflowSidebar()
        if wasActive then
            ctx.ActiveTab = nil
            local fallback = ctx.Tabs[1]
            if fallback then fallback:Select(false) end
        end
    end

    function Window:AddTab(name, iconId, isLua)
        if isLua and not ctx.LuaCategoryObj then
            ctx.LuaCategoryObj = Window:AddCategory("Lua Scripts", true)
        end
        ctx.TabOrder += 1
        local ord = ctx.TabOrder
        local cat = isLua and "Lua Scripts" or ctx.CurCategory

        local btn = U.New("TextButton", {
            Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, ctx.SidebarY),
            BackgroundColor3 = ctx.Theme.HoverBg, BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 15,
        }, ctx.MenuScroll)
        U.Corner(btn, 6)

        local ic = U.New("ImageLabel", {Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, 12, 0.5, -9), BackgroundTransparency = 1, Image = iconId or "", ZIndex = 16}, btn)
        ctx:BindAccent(ic, "ImageColor3")
        local tx = U.New("TextLabel", {Size = UDim2.new(1, -42, 1, 0), Position = UDim2.fromOffset(38, 0), BackgroundTransparency = 1, Text = name, TextColor3 = ctx.Theme.TextMuted, TextSize = 13, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 16}, btn)

        local subBar = U.New("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 13}, ctx.SubtabsHost)
        local subSl  = U.New("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, Visible = false, ZIndex = 13}, subBar)
        U.Corner(subSl, 5); ctx:BindDim(subSl, "BackgroundColor3")
        local subUl = U.New("Frame", {Size = UDim2.new(1, -12, 0, 2), Position = UDim2.new(0, 6, 1, -2), BorderSizePixel = 0, ZIndex = 14}, subSl)
        U.Round(subUl); ctx:BindAccent(subUl, "BackgroundColor3")

        local Tab = {
            Name = name, Order = ord, PosY = ctx.SidebarY, Category = cat, IsLua = isLua == true,
            Button = btn, Icon = ic, Text = tx, SubBar = subBar,
            SubX = 0, Subtabs = {}, ActiveSub = nil,
            TopActionBar = nil, CustomPage = nil,
        }
        table.insert(ctx.SidebarItems, {kind = "Tab", inst = btn, tab = Tab})
        ctx:ReflowSidebar()

        function Tab:AddSubtab(subName)
            local idx = #self.Subtabs + 1
            local w   = math.ceil(S.TextService:GetTextSize(subName, 12, Library.Font, Vector2.new(300, 32)).X) + 28
            local x   = self.SubX
            self.SubX += w + 6

            local sb = U.New("TextButton", {
                Size = UDim2.new(0, w, 1, 0), Position = UDim2.fromOffset(x, 0),
                BackgroundColor3 = ctx.Theme.HoverBg, BackgroundTransparency = 1, BorderSizePixel = 0,
                Text = subName, TextColor3 = ctx.Theme.TextMuted, TextSize = 12, Font = Library.Font,
                AutoButtonColor = false, ZIndex = 15,
            }, subBar)
            U.Corner(sb, 5)

            local page, lCol, rCol = U.CreatePageColumns(ctx, name .. "_" .. subName)
            local Sub = {Name = subName, Index = idx, Button = sb, Page = page}

            local function moveInd(inst)
                if inst or not subSl.Visible then
                    subSl.Visible, subSl.Position, subSl.Size = true, UDim2.fromOffset(x, 0), UDim2.new(0, w, 1, 0)
                else
                    ctx:Tween(subSl, ctx:Dur(0.26), {Position = UDim2.fromOffset(x, 0), Size = UDim2.new(0, w, 1, 0)}, Enum.EasingStyle.Quint)
                end
            end

            function Sub:Select(inst)
                local old = Tab.ActiveSub
                if old == Sub and not inst then return end
                local dir = (old and idx > old.Index) and 1 or -1
                if old and old ~= Sub then ctx:Tween(old.Button, ctx:Dur(0.18), {TextColor3 = ctx.Theme.TextMuted, BackgroundTransparency = 1}) end
                Tab.ActiveSub = Sub
                ctx:Tween(sb, ctx:Dur(0.2), {TextColor3 = ctx.Theme.TextWhite, BackgroundTransparency = 1})
                moveInd(inst)
                if ctx.ActiveTab == Tab then U.TransitionPage(ctx, page, 22 * dir, 0, inst) end
            end

            function Sub:AddGroupbox(gTitle, side)
                return U.CreateGroupbox(ctx, (side == "Right") and rCol or lCol, gTitle, Tab, Sub)
            end

            sb.MouseEnter:Connect(function() if ctx:CanInteract() and Tab.ActiveSub ~= Sub then ctx:Tween(sb, ctx:Dur(0.14), {TextColor3 = Color3.fromRGB(220, 232, 248), BackgroundTransparency = 0.6}) end end)
            sb.MouseLeave:Connect(function() if ctx:CanInteract() and Tab.ActiveSub ~= Sub then ctx:Tween(sb, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted, BackgroundTransparency = 1}) end end)
            sb.MouseButton1Click:Connect(function() if ctx:CanInteract() then Sub:Select(false) end end)

            Sub._moveInd = moveInd
            table.insert(self.Subtabs, Sub)
            return Sub
        end

        function Tab:AddGroupbox(gTitle, side)
            if #self.Subtabs == 0 then self:AddSubtab("Main") end
            return self.Subtabs[1]:AddGroupbox(gTitle, side)
        end

        function Tab:Select(inst)
            if ctx.ActiveTab == Tab and not inst then return end
            local prev = ctx.ActiveTab
            local dirY = (prev and ord > prev.Order) and 1 or -1
            if prev and prev ~= Tab then
                ctx:Tween(prev.Button, ctx:Dur(0.16), {BackgroundTransparency = 1})
                ctx:Tween(prev.Text, ctx:Dur(0.2), {TextColor3 = ctx.Theme.TextMuted, Position = UDim2.fromOffset(38, 0)})
                ctx:Tween(prev.Icon, ctx:Dur(0.2), {Position = UDim2.new(0, 12, 0.5, -9)})
                prev.SubBar.Visible = false
            end
            ctx.ActiveTab = Tab

            if prev and prev.TopActionBar then prev.TopActionBar.Visible = false end
            if inst or not ctx.TabSlider.Visible then
                ctx.TabSlider.Visible, ctx.TabSlider.Position = true, UDim2.fromOffset(10, Tab.PosY)
            else
                ctx:Tween(ctx.TabSlider, ctx:Dur(0.26), {Position = UDim2.fromOffset(10, Tab.PosY)}, Enum.EasingStyle.Quint)
            end
            ctx:Tween(btn, ctx:Dur(0.16), {BackgroundTransparency = 1})
            ctx:Tween(tx, ctx:Dur(0.2), {TextColor3 = ctx.Theme.TextWhite, Position = UDim2.fromOffset(41, 0)})
            ctx:Tween(ic, ctx:Dur(0.2), {Position = UDim2.new(0, 15, 0.5, -9)})

            if Tab.TopActionBar then
                ctx.HeaderTitle.Visible    = false
                ctx.SubtabsHost.Visible    = false
                ctx.TopActionsHost.Visible = true
                Tab.TopActionBar.Visible   = true
            else
                ctx.TopActionsHost.Visible = false
                ctx.HeaderTitle.Visible    = true
                ctx.SubtabsHost.Visible    = false
                ctx.HeaderTitle.Text = (cat ~= "" and (cat .. "  /  ") or "") .. name
                if not inst then ctx.HeaderTitle.TextTransparency = 0.6; ctx:Tween(ctx.HeaderTitle, ctx:Dur(0.22), {TextTransparency = 0}) end
            end

            if Tab.CustomPage then
                subBar.Visible = false
                U.TransitionPage(ctx, Tab.CustomPage, 0, 18 * dirY, inst)
            else
                subBar.Visible = false
                local sub = Tab.ActiveSub or Tab.Subtabs[1]
                if sub then
                    if Tab.ActiveSub ~= sub then Tab.ActiveSub = sub; sub.Button.TextColor3 = ctx.Theme.TextWhite end
                    sub._moveInd(true)
                    U.TransitionPage(ctx, sub.Page, 0, 18 * dirY, inst)
                else
                    U.TransitionPage(ctx, nil, 0, 0, inst)
                end
            end
        end

        btn.MouseEnter:Connect(function() if ctx:CanInteract() and ctx.ActiveTab ~= Tab then ctx:Tween(btn, ctx:Dur(0.14), {BackgroundTransparency = 0.6}); ctx:Tween(tx, ctx:Dur(0.14), {TextColor3 = Color3.fromRGB(215, 228, 245), Position = UDim2.fromOffset(41, 0)}); ctx:Tween(ic, ctx:Dur(0.14), {Position = UDim2.new(0, 15, 0.5, -9)}) end end)
        btn.MouseLeave:Connect(function() if ctx:CanInteract() and ctx.ActiveTab ~= Tab then ctx:Tween(btn, ctx:Dur(0.14), {BackgroundTransparency = 1}); ctx:Tween(tx, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted, Position = UDim2.fromOffset(38, 0)}); ctx:Tween(ic, ctx:Dur(0.14), {Position = UDim2.new(0, 12, 0.5, -9)}) end end)
        btn.MouseButton1Click:Connect(function() if ctx:CanInteract() then Tab:Select(false) end end)

        table.insert(ctx.Tabs, Tab)
        return Tab
    end

    function Window:SetWatermark(visible)
        ctx.Settings.Watermark = visible
        U.StartFade(ctx, ctx.WatermarkFrame, visible and 0 or 1, visible and 1 or 0, ctx:Dur(0.2))
    end

    function Window:SetHotkeys(visible)
        ctx.Settings.HotkeysEnabled = visible
        ctx.RefreshHotkeys()
    end

    function Window:AttachConfigs(tabObj)
        U.BuildConfigPage(ctx, tabObj)
    end

    function Window:Notify(title, msg, kind)
        ctx.Notify(title, msg, kind)
    end

    function Window:SetOpen(open) setMenuOpen(open) end
    function Window:Unload() if ctx.Gui then ctx.Gui:Destroy() end end

    task.defer(function()
        if not ctx.ActiveTab and ctx.Tabs[1] then
            ctx.Tabs[1]:Select(true)
        end
        setMenuOpen(true)
    end)

    return Window
end

