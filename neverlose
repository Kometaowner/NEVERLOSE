function U.GetGuiParent()
    if gethui then
        local ok, res = pcall(gethui)
        if ok and res then return res end
    end
    local ok, cg = pcall(function()
        local c = game:GetService("CoreGui")
        local f = Instance.new("Folder")
        f.Parent = c
        f:Destroy()
        return c
    end)
    if ok and cg then return cg end
    return S.Players.LocalPlayer:WaitForChild("PlayerGui")
end

function U.New(className, props, parent)
    local inst = Instance.new(className)
    if props then
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

function U.Corner(parent, r)
    return U.New("UICorner", {CornerRadius = UDim.new(0, r or 6)}, parent)
end

function U.Round(parent)
    return U.New("UICorner", {CornerRadius = UDim.new(1, 0)}, parent)
