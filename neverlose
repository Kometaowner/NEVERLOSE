local Storage = {
    MemConfigs = {},
}

Storage.HasFS = function()
    return (type(isfolder) == "function"
        and type(makefolder) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function")
end

Storage.EnsureFolders = function()
    if not Storage.HasFS() then return end
    pcall(function()
        if not isfolder("NeverloseUI") then makefolder("NeverloseUI") end
        if not isfolder("NeverloseUI/Configs") then makefolder("NeverloseUI/Configs") end
    end)
end

Storage.SafeName = function(name)
    local s = tostring(name or ""):gsub("[^%w%-%_%.%s%(%)]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return (#s > 0) and s or "Untitled"
end

Storage.FileKey = function(name)
    local s = tostring(name or ""):gsub("[^%w%-%_]", "_")
    return (#s > 0) and s or "item"
end

Storage.NowStr = function()
    return os.date("%d.%m %H:%M")
end

Storage.CopyToClipboard = function(text)
    local fn = setclipboard or toclipboard or (Clipboard and Clipboard.set)
    if type(fn) == "function" then
        local ok = pcall(fn, tostring(text))
        return ok
    end
    return false
end

Storage.SaveJson = function(path, tbl)
    local ok, encoded = pcall(function() return S.HttpService:JSONEncode(tbl) end)
    if not ok then return false end
    if Storage.HasFS() then
        Storage.EnsureFolders()
        local wok = pcall(writefile, path, encoded)
        return wok
    end
    return true
end

Storage.ReadJson = function(path)
    if not Storage.HasFS() then return nil end
    if type(isfile) == "function" and not isfile(path) then return nil end
    local ok, raw = pcall(readfile, path)
    if not ok or not raw or raw == "" then return nil end
    local dok, data = pcall(function() return S.HttpService:JSONDecode(raw) end)
    return dok and data or nil
end

Storage.DeleteFile = function(path)
    if Storage.HasFS() and type(delfile) == "function" then
        pcall(function()
            if (type(isfile) ~= "function") or isfile(path) then delfile(path) end
        end)
    end
end

U.Storage = Storage

