        local w = U.New("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 123}, svBox)
        U.New("UIGradient", {Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})}, w)
        local b = U.New("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 124}, svBox)
        U.New("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})}, b)
    end

    local svCursor = U.New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, ZIndex = 126}, svBox)
    U.Round(svCursor)
    U.Stroke(svCursor, Color3.new(1, 1, 1), 2, 0)

    local hueBar = U.New("TextButton", {
        Size = UDim2.fromOffset(212, 14), Position = UDim2.fromOffset(12, 190),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 122,
    }, popup)
    U.Round(hueBar)
    U.New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
        }),
    }, hueBar)

    local hueKnob = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 18),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0, ZIndex = 125,
    }, hueBar)
    U.Round(hueKnob)
    U.Stroke(hueKnob, Color3.fromRGB(15, 20, 30), 1.5, 0)

    local preview = U.New("Frame", {Size = UDim2.fromOffset(44, 26), Position = UDim2.fromOffset(12, 216), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 122}, popup)
    U.Corner(preview, 5)

    local hexBox = U.New("TextBox", {
        Size = UDim2.fromOffset(160, 26), Position = UDim2.fromOffset(64, 216),
        BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0,
        Text = "#FFFFFF", TextColor3 = ctx.Theme.TextWhite, PlaceholderColor3 = ctx.Theme.TextMuted,
        TextSize = 12, Font = Library.Font, ClearTextOnFocus = false, ZIndex = 122,
    }, popup)
    U.Corner(hexBox, 5)

    local st = {open = false, h = 0.62, s = 1, v = 1, anchor = nil, cb = nil, dragSV = false, dragHue = false}

    local function sync(fire)
        local col = Color3.fromHSV(st.h, st.s, st.v)
        svBox.BackgroundColor3   = Color3.fromHSV(st.h, 1, 1)
        svCursor.Position        = UDim2.new(st.s, 0, 1 - st.v, 0)
        hueKnob.Position         = UDim2.new(st.h, 0, 0.5, 0)
        preview.BackgroundColor3 = col
        if not hexBox:IsFocused() then hexBox.Text = U.ColorToHex(col) end
        if fire and st.cb then st.cb(col) end
    end

    local function close()
        if not st.open then return end
        st.open, st.dragSV, st.dragHue, st.anchor = false, false, false, nil
        ctx:Tween(scale, ctx:Dur(0.16), {Scale = 0.94}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        U.StartFade(ctx, popup, 1, 0, ctx:Dur(0.16))
    end

    U.CreateCloseButton(ctx, header, close)

    local function open(titleTxt, initCol, anchor, cb)
        if st.open and st.anchor == anchor then close() return end
        ctx.CloseDropdown()
        ctx.CloseKeybindMenu()
        title.Text, st.cb, st.anchor = titleTxt or "Color Palette", cb, anchor
        st.h, st.s, st.v = Color3.toHSV(initCol or Color3.new(1, 1, 1))
        sync(false)

        local cam = workspace.CurrentCamera
        local vp  = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        local px, py = vp.X * 0.5 - 118, vp.Y * 0.5 - 128
        if anchor then
            px = anchor.AbsolutePosition.X + anchor.AbsoluteSize.X + 10
            py = anchor.AbsolutePosition.Y - 20
            if px + 244 > vp.X then px = anchor.AbsolutePosition.X - 246 end
            py = math.clamp(py, 12, vp.Y - 268)
        end
        popup.Position = UDim2.fromOffset(px, py)
        st.open = true
        scale.Scale = 0.94
        ctx:Tween(scale, ctx:Dur(0.22), {Scale = 1})
        U.StartFade(ctx, popup, 0, 1, ctx:Dur(0.2))
    end

    svBox.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            st.dragSV = true
            st.s = math.clamp((inp.Position.X - svBox.AbsolutePosition.X) / math.max(svBox.AbsoluteSize.X, 1), 0, 1)
            st.v = 1 - math.clamp((inp.Position.Y - svBox.AbsolutePosition.Y) / math.max(svBox.AbsoluteSize.Y, 1), 0, 1)
            sync(true)
        end
    end)
    hueBar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            st.dragHue = true
            st.h = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 0.999)
            sync(true)
        end
    end)
    ctx:Bind(S.UIS.InputChanged, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement then
            if st.dragSV then
                st.s = math.clamp((inp.Position.X - svBox.AbsolutePosition.X) / math.max(svBox.AbsoluteSize.X, 1), 0, 1)
                st.v = 1 - math.clamp((inp.Position.Y - svBox.AbsolutePosition.Y) / math.max(svBox.AbsoluteSize.Y, 1), 0, 1)
                sync(true)
            elseif st.dragHue then
                st.h = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 0.999)
                sync(true)
            end
        end
    end)
    ctx:Bind(S.UIS.InputEnded, function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then st.dragSV, st.dragHue = false, false end
    end)
    hexBox.FocusLost:Connect(function()
        local parsed = U.HexToColor(hexBox.Text)
        if parsed then st.h, st.s, st.v = Color3.toHSV(parsed); sync(true) else sync(false) end
    end)

    ctx.OpenColorPicker  = open
    ctx.CloseColorPicker = close
end

