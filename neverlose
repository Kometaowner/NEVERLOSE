function U.FormatKey(inputType, keyCode)
    if inputType == Enum.UserInputType.MouseButton1 then return "MB1" end
    if inputType == Enum.UserInputType.MouseButton2 then return "MB2" end
    if inputType == Enum.UserInputType.MouseButton3 then return "MB3" end
    if keyCode and keyCode ~= Enum.KeyCode.Unknown then
        local map = {
            LeftShift = "LShift", RightShift = "RShift",
            LeftControl = "LCtrl", RightControl = "RCtrl",
            LeftAlt = "LAlt", RightAlt = "RAlt",
            Space = "Space", Backspace = "Bksp",
        }
        return map[keyCode.Name] or keyCode.Name
    end
    return "None"
end

function U.ColorToHex(c)
    return string.format("#%02X%02X%02X",
        math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)
    )
end

function U.HexToColor(str)
    local clean = str:gsub("#", ""):gsub("%s+", "")
    if #clean == 6 then
        local r = tonumber(clean:sub(1, 2), 16)
        local g = tonumber(clean:sub(3, 4), 16)
        local b = tonumber(clean:sub(5, 6), 16)
        if r and g and b then return Color3.fromRGB(r, g, b) end
    end
    return nil
end

function U.PointInGui(guiObj, pos)
    if not guiObj or not guiObj.Visible then return false end
    local ap, as = guiObj.AbsolutePosition, guiObj.AbsoluteSize
    return pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
end

function U.CreateContext(opts)
    local ctx = {
        LocalPlayer  = S.Players.LocalPlayer,
        Opts         = opts or {},
        Connections  = {},
        ActiveTweens = {},
        ActiveFades  = {},
        DragEntries  = {},
        AvatarLabels = {},
        AvatarThumb  = "",
        AccentBinds  = {},
        DimBinds     = {},
        AccentCbs    = {},
        SearchList   = {},
        Binds        = {},
        HotkeyRows   = {},
        AllPages       = {},
        Tabs           = {},
        SidebarItems   = {},
        ConfigRegistry = {},
        ConfigMap      = {},
        Configs        = {},
        ActiveConfig   = nil,
        TabOrder       = 0,
        SidebarY       = 2,
        CurCategory    = "",
        MenuOpen     = false,
        AboutOpen    = false,
        SearchOpen   = false,
        HotkeysShown = true,
        Settings     = {
            AutoSave       = true,
            Language       = "Русский",
            MenuScale      = 1.0,
            EspScale       = 1.0,
            AnimSpeed      = 1.5,
            Watermark      = (opts and opts.Watermark ~= nil) and opts.Watermark or true,
            HotkeysEnabled = (opts and opts.Hotkeys ~= nil) and opts.Hotkeys or true,
        },
        Theme = {
            BgMain       = Color3.fromRGB(8, 12, 20),
            BgSidebar    = Color3.fromRGB(12, 18, 29),
            BgContent    = Color3.fromRGB(6, 9, 15),
            BgGroup      = Color3.fromRGB(11, 16, 26),
            BgElement    = Color3.fromRGB(15, 22, 35),
            BgDropdown   = Color3.fromRGB(11, 15, 24),
            Border       = Color3.fromRGB(24, 38, 58),
            Accent       = Color3.fromRGB(92, 136, 255),
            AccentDim    = Color3.fromRGB(20, 36, 70),
            HoverBg      = Color3.fromRGB(18, 29, 48),
            TextWhite    = Color3.fromRGB(255, 255, 255),
            TextMuted    = Color3.fromRGB(132, 146, 168),
            TextCategory = Color3.fromRGB(78, 96, 122),
        },
    }

    function ctx:Bind(signal, fn)
        local c = signal:Connect(fn)
        table.insert(self.Connections, c)
        return c
    end

    function ctx:Dur(base)
        local m = math.clamp(self.Settings.AnimSpeed / 1.5, 0.35, 2.5)
        return math.max(base / m, 0.04)
    end

    function ctx:Tween(obj, dur, props, style, dir)
        if not obj or not obj.Parent then return nil end
        if self.ActiveTweens[obj] then self.ActiveTweens[obj]:Cancel() end
        local tw = S.Tween:Create(
            obj,
            TweenInfo.new(dur, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
            props
        )
        self.ActiveTweens[obj] = tw
        tw:Play()
        return tw
    end

    function ctx:BindAccent(inst, prop)
        table.insert(self.AccentBinds, {inst = inst, prop = prop})
        inst[prop] = self.Theme.Accent
    end

    function ctx:BindDim(inst, prop)
        table.insert(self.DimBinds, {inst = inst, prop = prop})
        inst[prop] = self.Theme.AccentDim
    end

    function ctx:SetAccent(col)
        self.Theme.Accent = col
        local h, s = Color3.toHSV(col)
        self.Theme.AccentDim = Color3.fromHSV(h, math.clamp(s * 0.85, 0, 1), 0.28)
        local d = self:Dur(0.22)
        for _, b in ipairs(self.AccentBinds) do
            if b.inst and b.inst.Parent then self:Tween(b.inst, d, {[b.prop] = self.Theme.Accent}) end
        end
        for _, b in ipairs(self.DimBinds) do
            if b.inst and b.inst.Parent then self:Tween(b.inst, d, {[b.prop] = self.Theme.AccentDim}) end
        end
        for _, cb in ipairs(self.AccentCbs) do
            cb(self.Theme.Accent, self.Theme.AccentDim)
        end
    end

    -- ========================================================================
    -- ПЛАВНОЕ ИНЕРЦИОННОЕ ПЕРЕТАСКИВАНИЕ С АНИМАЦИЕЙ ПОДЪЁМА И ПОДСВЕТКИ
    -- ========================================================================
    function ctx:MakeDraggable(handles, target, dragOpts)
        dragOpts = dragOpts or {}
        local handleList = (typeof(handles) == "Instance") and {handles} or handles

        local entry = {
            target       = target,
            active       = false,
            settling     = false,
            mouseStart   = nil,
            startPos     = nil,
            targetPos    = target.Position,
            smoothness   = dragOpts.Smoothness or 20,
            scaleObj     = dragOpts.ScaleObj,
            getBaseScale = dragOpts.GetBaseScale or function() return 1 end,
            liftMult     = dragOpts.LiftMult or 1.02,
            strokes      = {},
        }

        if dragOpts.Strokes then
            for _, st in ipairs(dragOpts.Strokes) do
                table.insert(entry.strokes, {
                    obj    = st,
                    origC  = st.Color,
                    origTr = st.Transparency,
                })
            end
        end

        local function setVisualDrag(isDragging)
            local baseScale = entry.getBaseScale()
            if entry.scaleObj and entry.scaleObj.Parent then
                if isDragging then
                    self:Tween(entry.scaleObj, self:Dur(0.16), {Scale = baseScale * entry.liftMult}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                else
                    self:Tween(entry.scaleObj, self:Dur(0.24), {Scale = baseScale}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end
            end
            for _, sInfo in ipairs(entry.strokes) do
                if sInfo.obj and sInfo.obj.Parent then
                    if isDragging then
                        self:Tween(sInfo.obj, self:Dur(0.16), {Color = self.Theme.Accent, Transparency = 0.22})
                    else
                        self:Tween(sInfo.obj, self:Dur(0.22), {Color = sInfo.origC, Transparency = sInfo.origTr})
                    end
                end
            end
        end

        entry.cancel = function()
            if entry.active then
                entry.active = false
                setVisualDrag(false)
            end
        end

        for _, handle in ipairs(handleList) do
            handle.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    entry.active     = true
                    entry.settling   = true
                    entry.mouseStart = inp.Position
                    entry.startPos   = target.Position
                    entry.targetPos  = target.Position
                    setVisualDrag(true)
                end
            end)
        end

        self:Bind(S.UIS.InputChanged, function(inp)
            if entry.active and inp.UserInputType == Enum.UserInputType.MouseMovement then
                local d = inp.Position - entry.mouseStart
                entry.targetPos = UDim2.new(
                    entry.startPos.X.Scale, entry.startPos.X.Offset + d.X,
                    entry.startPos.Y.Scale, entry.startPos.Y.Offset + d.Y
                )
            end
        end)

        self:Bind(S.UIS.InputEnded, function(inp)
            if entry.active and inp.UserInputType == Enum.UserInputType.MouseButton1 then
                entry.active = false
                setVisualDrag(false)
            end
        end)

        table.insert(self.DragEntries, entry)
        return entry
    end

    function ctx:StepDrags(dt)
        local speedMul = math.clamp(self.Settings.AnimSpeed / 1.5, 0.5, 2.0)
        for _, e in ipairs(self.DragEntries) do
            if e.settling and e.target and e.target.Parent then
                local cur = e.target.Position
                local tgt = e.targetPos
                local a   = 1 - math.exp(-(e.smoothness * speedMul) * dt)

                local nxS = cur.X.Scale  + (tgt.X.Scale  - cur.X.Scale)  * a
                local nxO = cur.X.Offset + (tgt.X.Offset - cur.X.Offset) * a
                local nyS = cur.Y.Scale  + (tgt.Y.Scale  - cur.Y.Scale)  * a
                local nyO = cur.Y.Offset + (tgt.Y.Offset - cur.Y.Offset) * a

                local dx = math.abs(tgt.X.Offset - nxO)
                local dy = math.abs(tgt.Y.Offset - nyO)

                if not e.active and dx < 0.25 and dy < 0.25 then
                    e.target.Position = tgt
                    e.settling = false
                else
                    e.target.Position = UDim2.new(nxS, nxO, nyS, nyO)
                end
            end
        end
    end

    function ctx:CancelAllDrags()
        for _, e in ipairs(self.DragEntries) do
            e.cancel()
        end
    end

    function ctx:CanInteract()
        return self.ActiveFades[self.MainFrame] == nil and self.MainFrame and self.MainFrame.Visible
    end

    return ctx
end

-- ============================================================================
-- ДВИЖОК АЛЬФА-АНИМАЦИЙ (FADE IN / FADE OUT БЕЗ CANVASGROUP)
-- ============================================================================
function U.CaptureSnap(root)
    local snap = {}
    local function visit(inst, isRoot)
        if not isRoot and inst:IsA("GuiObject") and not inst.Visible then return end
        if inst:IsA("GuiObject") then
            local e = {inst = inst, kind = "Gui", bg = inst.BackgroundTransparency}
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                e.txt, e.txtS = inst.TextTransparency, inst.TextStrokeTransparency
            end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                e.img = inst.ImageTransparency
            end
            if inst:IsA("ScrollingFrame") then
                e.scr = inst.ScrollBarImageTransparency
            end
            table.insert(snap, e)
        elseif inst:IsA("UIStroke") then
            table.insert(snap, {inst = inst, kind = "Stroke", st = inst.Transparency})
        end
        for _, ch in ipairs(inst:GetChildren()) do
            visit(ch, false)
        end
    end
    visit(root, true)
    return snap
end

function U.ApplySnap(snap, alpha)
    local inv = 1 - math.clamp(alpha, 0, 1)
    for _, e in ipairs(snap) do
        local i = e.inst
        if i and i.Parent then
            if e.kind == "Gui" then
                i.BackgroundTransparency = e.bg + (1 - e.bg) * inv
                if e.txt ~= nil then
                    i.TextTransparency       = e.txt + (1 - e.txt) * inv
                    i.TextStrokeTransparency = e.txtS + (1 - e.txtS) * inv
                end
                if e.img ~= nil then i.ImageTransparency = e.img + (1 - e.img) * inv end
                if e.scr ~= nil then i.ScrollBarImageTransparency = e.scr + (1 - e.scr) * inv end
            else
                i.Transparency = e.st + (1 - e.st) * inv
            end
        end
    end
end

function U.FinishFade(ctx, root)
    local f = ctx.ActiveFades[root]
    if not f then return end
    ctx.ActiveFades[root] = nil
    root.Visible = (f.target > 0)
    U.ApplySnap(f.snap, 1)
    if f.onDone then f.onDone(true) end
end

function U.StartFade(ctx, root, fromA, toA, dur, onDone)
    local ex   = ctx.ActiveFades[root]
    local snap = ex and ex.snap or U.CaptureSnap(root)
    local stA  = ex and ex.alpha or fromA
    if toA > 0 then root.Visible = true end

    local realDur = math.max(dur * math.abs(toA - stA), 0.01)
    ctx.ActiveFades[root] = {
        snap = snap, startA = stA, target = toA, alpha = stA,
        elapsed = 0, dur = realDur, onDone = onDone,
    }
    U.ApplySnap(snap, stA)
end

function U.StepFades(ctx, dt)
    local done = {}
    for root, f in pairs(ctx.ActiveFades) do
        if not root or not root.Parent then
            table.insert(done, root)
        else
            f.elapsed += dt
            local p = math.clamp(f.elapsed / f.dur, 0, 1)
            local e = (f.target > f.startA) and (1 - (1 - p) ^ 3) or (p * p)
            f.alpha = f.startA + (f.target - f.startA) * e
            U.ApplySnap(f.snap, f.alpha)
            if p >= 1 then table.insert(done, root) end
        end
    end
    for _, root in ipairs(done) do
        local f = ctx.ActiveFades[root]
        if f then
            ctx.ActiveFades[root] = nil
            if f.target <= 0 then root.Visible = false end
            U.ApplySnap(f.snap, 1)
            if f.onDone then f.onDone(false) end
        end
    end
end

