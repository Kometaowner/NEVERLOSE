function U.RegisterConfigItem(ctx, tab, subtab, groupName, name, itemType, getFn, setFn)
    local subName = subtab and subtab.Name or "Main"
    local baseId = (tab and tab.Name or "Tab") .. "/" .. subName .. "/" .. (groupName or "Group") .. "/" .. (name or "Item")
    local id = baseId
    local n = 2
    while ctx.ConfigMap[id] do
        id = baseId .. "#" .. tostring(n)
        n += 1
    end
    local rec = {id = id, tab = tab, kind = itemType, get = getFn, set = setFn}
    ctx.ConfigMap[id] = rec
    table.insert(ctx.ConfigRegistry, rec)
    return rec
end

function U.RegisterSearch(ctx, name, groupName, tab, subtab, row)
    table.insert(ctx.SearchList, {
        Name = name, GroupName = groupName, Tab = tab, Subtab = subtab,
        Highlight = function()
            if not row or not row.Parent then return end
            local f = U.New("Frame", {
                Size = UDim2.new(1, 8, 1, 4), Position = UDim2.fromOffset(-4, -2),
                BackgroundColor3 = ctx.Theme.Accent, BackgroundTransparency = 0.72,
                BorderSizePixel = 0, ZIndex = row.ZIndex + 5,
            }, row)
            U.Corner(f, 5)
            local tw = ctx:Tween(f, 0.75, {BackgroundTransparency = 1})
            if tw then tw.Completed:Connect(function() f:Destroy() end) end
        end
    })
end

function U.AddToggleControl(ctx, holder, groupName, tab, subtab, labelText, opts)
    opts = opts or {}
    local state = opts.Default or false

    local row = U.New("Frame", {Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, ZIndex = 16}, holder)
    U.RegisterSearch(ctx, labelText, groupName, tab, subtab, row)

    local click = U.New("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 16}, row)
    local lbl   = U.New("TextLabel", {
        Size = UDim2.new(1, -124, 1, 0), BackgroundTransparency = 1, Text = labelText,
        TextColor3 = state and ctx.Theme.TextWhite or ctx.Theme.TextMuted,
        TextSize = 13, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 17,
    }, row)

    local sw = U.CreateNeverloseSwitch(ctx, row, UDim2.new(1, -38, 0.5, -9), state)
    local rightOff = 46
    local curCol, cBtn, bObj = opts.Color, nil, nil

    if opts.Color then
        cBtn = U.New("TextButton", {
            Size = UDim2.fromOffset(22, 18), Position = UDim2.new(1, -(rightOff + 22), 0.5, -9),
            BackgroundColor3 = curCol, BorderSizePixel = 0, Text = "", AutoButtonColor = false, Active = true, ZIndex = 19,
        }, row)
        U.Corner(cBtn, 5)
        cBtn.MouseButton1Click:Connect(function()
            if not ctx:CanInteract() then return end
            ctx.OpenColorPicker(labelText .. " Color", curCol, cBtn, function(c)
                curCol, cBtn.BackgroundColor3 = c, c
                if opts.ColorCallback then opts.ColorCallback(c) end
            end)
        end)
        rightOff += 30
    end

    local function apply(val, anim)
        state = val
        local d = anim and ctx:Dur(0.2) or 0
        ctx:Tween(lbl, d, {TextColor3 = state and ctx.Theme.TextWhite or ctx.Theme.TextMuted})
        sw.Set(state, anim)
        if opts.Callback then opts.Callback(state) end
        ctx.RefreshHotkeys()
    end

    if opts.Keybind then
        local chip = U.New("TextButton", {
            Size = UDim2.fromOffset(48, 18), Position = UDim2.new(1, -(rightOff + 48), 0.5, -9),
            BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0,
            Text = opts.DefaultKey and ("[" .. U.FormatKey(nil, opts.DefaultKey) .. "]") or "[Bind]",
            TextColor3 = opts.DefaultKey and ctx.Theme.TextWhite or ctx.Theme.TextMuted,
            TextSize = 10, Font = Library.Font, AutoButtonColor = false, Active = true, ZIndex = 19,
        }, row)
        U.Corner(chip, 4)

        bObj = {
            Name = labelText, Tab = tab, KeyCode = opts.DefaultKey, InputType = nil,
            Mode = opts.DefaultMode or "Toggle", ShowInList = true,
            GetState = function() return state end,
            SetState = function(_, v) apply(v, true) end,
        }
        function bObj:UpdateChip()
            if ctx.ListeningBind == self then
                chip.Text, chip.TextColor3 = "[...]", ctx.Theme.Accent
            else
                local kl = U.FormatKey(self.InputType, self.KeyCode)
                if self.Mode == "Always" then
                    chip.Text, chip.TextColor3 = "[On]", ctx.Theme.Accent
                elseif kl == "None" then
                    chip.Text, chip.TextColor3 = "[Bind]", ctx.Theme.TextMuted
                else
                    chip.Text, chip.TextColor3 = "[" .. kl .. "]", ctx.Theme.TextWhite
                end
            end
            ctx.RefreshHotkeys()
        end
        function bObj:SetMode(m) self.Mode = m; if m == "Always" then apply(true, true) end; self:UpdateChip() end
        function bObj:ClearKey() self.KeyCode, self.InputType = nil, nil; if self.Mode == "Always" then self.Mode = "Toggle" end; self:UpdateChip() end

        chip.MouseButton1Click:Connect(function()
            if not ctx:CanInteract() then return end
            ctx.CloseKeybindMenu()
            if ctx.ListeningBind and ctx.ListeningBind ~= bObj then
                local prev = ctx.ListeningBind; ctx.ListeningBind = nil; prev:UpdateChip()
            end
            ctx.ListeningBind = bObj
            bObj:UpdateChip()
        end)
        chip.MouseButton2Click:Connect(function()
            if not ctx:CanInteract() then return end
            ctx.OpenKeybindMenu(bObj, chip)
        end)
        table.insert(ctx.Binds, bObj)
    end

    click.MouseEnter:Connect(function()
        if ctx:CanInteract() then
            sw.SetHover(true)
            if not state then ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = Color3.fromRGB(205, 220, 240)}) end
        end
    end)
    click.MouseLeave:Connect(function()
        if ctx:CanInteract() then
            sw.SetHover(false)
            if not state then ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted}) end
        end
    end)
    click.MouseButton1Down:Connect(function()
        if ctx:CanInteract() then sw.SetPressed(true) end
    end)
    click.MouseButton1Click:Connect(function()
        if ctx:CanInteract() then apply(not state, true) end
    end)

    U.RegisterConfigItem(ctx, tab, subtab, groupName, labelText, "Toggle", function()
        local d = {state = state}
        if curCol then d.color = U.ColorToHex(curCol) end
        if bObj then
            d.key = bObj.KeyCode and bObj.KeyCode.Name or nil
            d.input = bObj.InputType and bObj.InputType.Name or nil
            d.mode = bObj.Mode
            d.show = bObj.ShowInList
        end
        return d
    end, function(d)
        if type(d) == "boolean" then
            apply(d, false)
            return
        end
        if type(d) ~= "table" then return end
        if d.state ~= nil then apply(d.state == true, false) end
        if d.color and cBtn then
            local c = U.HexToColor(d.color)
            if c then
                curCol, cBtn.BackgroundColor3 = c, c
                if opts.ColorCallback then opts.ColorCallback(c) end
            end
        end
        if bObj then
            bObj.KeyCode = (d.key and Enum.KeyCode[d.key]) or nil
            bObj.InputType = (d.input and Enum.UserInputType[d.input]) or nil
            if d.mode then bObj.Mode = d.mode end
            if d.show ~= nil then bObj.ShowInList = d.show end
            bObj:UpdateChip()
        end
    end)

    return { Set = function(_, v) apply(v, true) end, Get = function() return state end }
end

function U.AddSliderControl(ctx, holder, groupName, tab, subtab, labelText, opts)
    opts = opts or {}
    local minV, maxV = opts.Min or 0, opts.Max or 100
    local dec = opts.Decimals or 0
    local cur = math.clamp(opts.Default or minV, minV, maxV)

    local cont = U.New("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, ZIndex = 16}, holder)
    U.RegisterSearch(ctx, labelText, groupName, tab, subtab, cont)

    local lbl = U.New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Text = labelText,
        TextColor3 = ctx.Theme.TextMuted, TextSize = 12, Font = Library.Font,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 17,
    }, cont)

    local valPill = U.New("TextLabel", {
        Size = UDim2.fromOffset(42, 20), Position = UDim2.new(1, -42, 0, 17),
        BackgroundColor3 = Color3.fromRGB(15, 21, 33), BorderSizePixel = 0,
        Text = (dec > 0) and string.format("%." .. dec .. "f", cur) or tostring(math.floor(cur + 0.5)),
        TextColor3 = Color3.fromRGB(215, 224, 238), TextStrokeTransparency = 1,
        TextSize = 12, Font = Library.Font, ZIndex = 17,
    }, cont)
    U.Corner(valPill, 5)

    local hit = U.New("TextButton", {
        Size = UDim2.new(1, -54, 0, 20), Position = UDim2.fromOffset(0, 17),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 17,
    }, cont)

    local bg = U.New("Frame", {
        Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2),
        BackgroundColor3 = Color3.fromRGB(22, 31, 48), BorderSizePixel = 0, ZIndex = 17,
    }, hit)
    U.Round(bg)

    local a0   = (cur - minV) / math.max(maxV - minV, 0.0001)
    local fill = U.New("Frame", {Size = UDim2.new(a0, 0, 1, 0), BorderSizePixel = 0, ZIndex = 18}, bg)
    U.Round(fill)
    ctx:BindAccent(fill, "BackgroundColor3")

    local glow = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(a0, 0, 0.5, 0), BackgroundTransparency = 0.84,
        BorderSizePixel = 0, ZIndex = 18,
    }, bg)
    U.Round(glow)
    ctx:BindAccent(glow, "BackgroundColor3")

    local dot = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12),
        Position = UDim2.new(a0, 0, 0.5, 0), BorderSizePixel = 0, ZIndex = 19,
    }, bg)
    U.Round(dot)
    ctx:BindAccent(dot, "BackgroundColor3")

    local drag = false
    local function setAlpha(a, dur)
        a = math.clamp(a, 0, 1)
        local m = 10 ^ dec
        cur = math.floor((minV + (maxV - minV) * a) * m + 0.5) / m
        valPill.Text = (dec > 0) and string.format("%." .. dec .. "f", cur) or tostring(cur)

        local d = dur or 0.09
        ctx:Tween(fill, d, {Size = UDim2.new(a, 0, 1, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        ctx:Tween(dot,  d, {Position = UDim2.new(a, 0, 0.5, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        ctx:Tween(glow, d, {Position = UDim2.new(a, 0, 0.5, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        if opts.Callback then opts.Callback(cur) end
    end

    hit.MouseEnter:Connect(function()
        if ctx:CanInteract() then
            ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextWhite})
            ctx:Tween(dot, ctx:Dur(0.15), {Size = UDim2.fromOffset(14, 14)}, Enum.EasingStyle.Back)
            ctx:Tween(glow, ctx:Dur(0.15), {Size = UDim2.fromOffset(23, 23), BackgroundTransparency = 0.72})
        end
    end)
    hit.MouseLeave:Connect(function()
        if ctx:CanInteract() and not drag then
            ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted})
            ctx:Tween(dot, ctx:Dur(0.15), {Size = UDim2.fromOffset(12, 12)})
            ctx:Tween(glow, ctx:Dur(0.15), {Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 0.84})
        end
    end)
    hit.InputBegan:Connect(function(inp)
        if ctx:CanInteract() and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            ctx:Tween(dot, ctx:Dur(0.12), {Size = UDim2.fromOffset(15, 15)}, Enum.EasingStyle.Back)
            ctx:Tween(glow, ctx:Dur(0.12), {Size = UDim2.fromOffset(25, 25), BackgroundTransparency = 0.62})
            ctx:Tween(valPill, ctx:Dur(0.12), {TextColor3 = ctx.Theme.TextWhite, BackgroundColor3 = Color3.fromRGB(20, 30, 48)})
            setAlpha((inp.Position.X - bg.AbsolutePosition.X) / math.max(bg.AbsoluteSize.X, 1), ctx:Dur(0.14))
        end
    end)
    ctx:Bind(S.UIS.InputChanged, function(inp)
        if drag and inp.UserInputType == Enum.UserInputType.MouseMovement then
            setAlpha((inp.Position.X - bg.AbsolutePosition.X) / math.max(bg.AbsoluteSize.X, 1), 0.07)
        end
    end)
    ctx:Bind(S.UIS.InputEnded, function(inp)
        if drag and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
            ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted})
            ctx:Tween(dot, ctx:Dur(0.14), {Size = UDim2.fromOffset(12, 12)})
            ctx:Tween(glow, ctx:Dur(0.14), {Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 0.84})
            ctx:Tween(valPill, ctx:Dur(0.14), {TextColor3 = Color3.fromRGB(215, 224, 238), BackgroundColor3 = Color3.fromRGB(15, 21, 33)})
        end
    end)

    U.RegisterConfigItem(ctx, tab, subtab, groupName, labelText, "Slider",
        function() return cur end,
        function(v)
            if type(v) == "number" then
                setAlpha((math.clamp(v, minV, maxV) - minV) / math.max(maxV - minV, 0.0001), 0.08)
            end
        end
    )

    return {
        Set = function(_, v) setAlpha((math.clamp(v, minV, maxV) - minV) / math.max(maxV - minV, 0.0001), ctx:Dur(0.22)) end,
        Get = function() return cur end,
    }
end

function U.AddDropdownControl(ctx, holder, groupName, tab, subtab, labelText, opts)
    opts = opts or {}
    local list = opts.Options or {"None"}
    local sel  = opts.Default or 1

    local wrap = U.New("Frame", {Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, ZIndex = 16}, holder)
    U.RegisterSearch(ctx, labelText, groupName, tab, subtab, wrap)

    local lbl = U.New("TextLabel", {
        Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Text = labelText,
        TextColor3 = ctx.Theme.TextMuted, TextSize = 12, Font = Library.Font,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 17,
    }, wrap)

    local btn = U.New("TextButton", {
        Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 19),
        BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, ZIndex = 17,
    }, wrap)
    U.Corner(btn, 5)

    local selLbl = U.New("TextLabel", {
        Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1, Text = list[sel] or "", TextColor3 = ctx.Theme.TextWhite,
        TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 18,
    }, btn)

    local chev = U.CreateChevron(ctx, btn, UDim2.new(1, -14, 0.5, 0), ctx.Theme.TextMuted)
    local isOpen = false

    btn.MouseEnter:Connect(function()
        if ctx:CanInteract() then
            ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextWhite})
            if not isOpen then ctx:Tween(btn, ctx:Dur(0.14), {BackgroundColor3 = ctx.Theme.HoverBg}) end
        end
    end)
    btn.MouseLeave:Connect(function()
        if ctx:CanInteract() and not isOpen then
            ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted})
            ctx:Tween(btn, ctx:Dur(0.14), {BackgroundColor3 = ctx.Theme.BgElement})
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if not ctx:CanInteract() then return end
        isOpen = true
        chev:SetState(true)
        ctx:Tween(btn, ctx:Dur(0.14), {BackgroundColor3 = ctx.Theme.HoverBg})

        ctx.OpenDropdown(btn, list, sel, function(idx, name)
            sel, selLbl.Text = idx, name
            if opts.Callback then opts.Callback(idx, name) end
        end, function()
            isOpen = false
            chev:SetState(false)
            ctx:Tween(lbl, ctx:Dur(0.14), {TextColor3 = ctx.Theme.TextMuted})
            ctx:Tween(btn, ctx:Dur(0.14), {BackgroundColor3 = ctx.Theme.BgElement})
        end)
    end)

    U.RegisterConfigItem(ctx, tab, subtab, groupName, labelText, "Dropdown",
        function() return sel end,
        function(idx)
            if type(idx) == "number" and list[idx] then
                sel, selLbl.Text = idx, list[idx]
                if opts.Callback then opts.Callback(idx, list[idx]) end
            end
        end
    )

    return {
        Set = function(_, idx)
            if list[idx] then
                sel, selLbl.Text = idx, list[idx]
                if opts.Callback then opts.Callback(idx, list[idx]) end
            end
        end,
        Get = function() return sel, list[sel] end,
    }
end

function U.CreateGroupbox(ctx, parentCol, title, tab, subtab)
