function U.TransitionPage(ctx, newPage, ox, oy, instant)
    if ctx.CurPage == newPage and not instant then return end
    ctx.CloseDropdown()
    local old = ctx.CurPage
    for _, p in ipairs(ctx.AllPages) do
        if p ~= old and p ~= newPage then
            U.FinishFade(ctx, p)
            p.Visible, p.Position = false, UDim2.new(0, 0, 0, 0)
        end
    end
    ctx.CurPage = newPage

    if old and old ~= newPage then
        if instant then
            U.FinishFade(ctx, old); old.Visible, old.Position = false, UDim2.new(0, 0, 0, 0)
        else
            ctx:Tween(old, ctx:Dur(0.16), {Position = UDim2.fromOffset(-ox, -oy)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            U.StartFade(ctx, old, 1, 0, ctx:Dur(0.15), function()
                if ctx.CurPage ~= old then old.Position = UDim2.new(0, 0, 0, 0) end
            end)
        end
    end

    if newPage then
        if instant then
            U.FinishFade(ctx, newPage); newPage.Visible, newPage.Position = true, UDim2.new(0, 0, 0, 0)
        else
            newPage.Position = UDim2.fromOffset(ox, oy)
            ctx:Tween(newPage, ctx:Dur(0.24), {Position = UDim2.new(0, 0, 0, 0)})
            U.StartFade(ctx, newPage, 0, 1, ctx:Dur(0.22))
        end
    end
end

function U.CreatePageColumns(ctx, name)
    local page = U.New("ScrollingFrame", {
        Name = name .. "Page", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0), Visible = false, ZIndex = 13,
    }, ctx.PagesHost)
    ctx:BindAccent(page, "ScrollBarImageColor3")
    U.New("UIPadding", {PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 18), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18)}, page)

    local left  = U.New("Frame", {Size = UDim2.new(0.5, -9, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 13}, page)
    local right = U.New("Frame", {Size = UDim2.new(0.5, -9, 0, 0), Position = UDim2.new(0.5, 9, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 13}, page)
