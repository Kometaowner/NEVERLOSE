-- МОДУЛЬ 1: ПЛАВАЮЩИЙ ВЫПАДАЮЩИЙ СПИСОК (OVERLAY DROPDOWN)
-- ============================================================================
function U.BuildDropdownOverlay(ctx)
    local popup = U.New("Frame", {
        Name = "DropdownOverlay", Size = UDim2.fromOffset(220, 0),
        BackgroundColor3 = ctx.Theme.BgDropdown, BorderSizePixel = 0,
        ClipsDescendants = true, Visible = false, ZIndex = 115,
    }, ctx.Gui)
    U.Corner(popup, 7)
    U.Stroke(popup, ctx.Theme.Border, 1, 0.35)

    local listHolder = U.New("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 116}, popup)
    U.New("UIPadding", {PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)}, listHolder)
    U.New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, listHolder)

    local st = {open = false, anchor = nil, onClose = nil, token = 0}

    local function close()
        if not st.open then return end
        st.open = false
        st.token += 1
        local myTok, cb = st.token, st.onClose
        st.anchor, st.onClose = nil, nil
        if cb then cb() end

        ctx:Tween(popup, ctx:Dur(0.16), {Size = UDim2.fromOffset(popup.Size.X.Offset, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        U.StartFade(ctx, popup, 1, 0, ctx:Dur(0.15), function()
            if st.token == myTok and not st.open then popup.Visible = false end
        end)
    end

    local function open(anchorBtn, options, selectedIdx, onSelect, onCloseCb)
        if st.open and st.anchor == anchorBtn then close() return end
        if st.open then close() end

        ctx.CloseColorPicker()
        ctx.CloseKeybindMenu()
        ctx.CloseSearch()

        U.FinishFade(ctx, popup)
        for _, ch in ipairs(listHolder:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end

        st.token += 1
        st.open, st.anchor, st.onClose = true, anchorBtn, onCloseCb

        local itemH   = 28
        local targetH = (#options * itemH) + (math.max(#options - 1, 0) * 2) + 12
        local width   = math.max(anchorBtn.AbsoluteSize.X, 175)
        local ap      = anchorBtn.AbsolutePosition
        local cam     = workspace.CurrentCamera
        local vp      = cam and cam.ViewportSize or Vector2.new(1920, 1080)

        local posX = math.clamp(ap.X, 8, vp.X - width - 8)
        local posY = ap.Y + anchorBtn.AbsoluteSize.Y + 6
        if posY + targetH > vp.Y - 12 then posY = math.max(12, ap.Y - targetH - 6) end

        for i, optName in ipairs(options) do
            local isSel = (i == selectedIdx)
            local ob = U.New("TextButton", {
                Size = UDim2.new(1, 0, 0, itemH),
                BackgroundColor3 = Color3.fromRGB(22, 31, 48),
                BackgroundTransparency = isSel and 0.25 or 1,
                BorderSizePixel = 0,
                Text = "   " .. optName,
                TextColor3 = isSel and ctx.Theme.TextWhite or Color3.fromRGB(168, 178, 196),
                TextSize = 13, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false, LayoutOrder = i, ZIndex = 117,
            }, listHolder)
            U.Corner(ob, 5)

            ob.MouseEnter:Connect(function() ctx:Tween(ob, ctx:Dur(0.12), {BackgroundTransparency = 0.2, TextColor3 = ctx.Theme.TextWhite}) end)
            ob.MouseLeave:Connect(function()
                if i ~= selectedIdx then
                    ctx:Tween(ob, ctx:Dur(0.12), {BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(168, 178, 196)})
                else
                    ctx:Tween(ob, ctx:Dur(0.12), {BackgroundTransparency = 0.25, TextColor3 = ctx.Theme.TextWhite})
                end
            end)
            ob.MouseButton1Click:Connect(function()
                if onSelect then onSelect(i, optName) end
                close()
            end)
        end

        popup.Position = UDim2.fromOffset(posX, posY - 4)
        popup.Size     = UDim2.fromOffset(width, math.min(20, targetH))
        ctx:Tween(popup, ctx:Dur(0.22), {Position = UDim2.fromOffset(posX, posY), Size = UDim2.fromOffset(width, targetH)})
        U.StartFade(ctx, popup, 0, 1, ctx:Dur(0.18))
    end

    ctx:Bind(S.UIS.InputBegan, function(inp)
        if st.open and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if not U.PointInGui(popup, inp.Position) and not U.PointInGui(st.anchor, inp.Position) then
                close()
            end
        end
    end)

    ctx.OpenDropdown  = open
    ctx.CloseDropdown = close
end

