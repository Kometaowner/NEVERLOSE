                end

                rowBtn.MouseEnter:Connect(function()
                    ctx:Tween(rowBtn, ctx:Dur(0.1), {BackgroundTransparency = 0.35})
                    ctx:Tween(dot, ctx:Dur(0.1), {BackgroundTransparency = 0})
                    if not isDanger then ctx:Tween(txLbl, ctx:Dur(0.1), {TextColor3 = ctx.Theme.TextWhite}) end
                end)
                rowBtn.MouseLeave:Connect(function()
                    ctx:Tween(rowBtn, ctx:Dur(0.1), {BackgroundTransparency = 1})
                    ctx:Tween(dot, ctx:Dur(0.1), {BackgroundTransparency = isDanger and 0.1 or 0.55})
                    if not isDanger then ctx:Tween(txLbl, ctx:Dur(0.1), {TextColor3 = Color3.fromRGB(210, 220, 236)}) end
                end)
                rowBtn.MouseButton1Click:Connect(function()
                    close()
                    if item.OnClick then task.defer(item.OnClick) end
                end)
                totalH += 30
            end
        end

        local w = 172
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        local ap = anchor.AbsolutePosition
        local px = math.clamp(ap.X - w + anchor.AbsoluteSize.X + 8, 10, vp.X - w - 10)
        local py = ap.Y + anchor.AbsoluteSize.Y + 6
        if py + totalH > vp.Y - 12 then py = math.max(12, ap.Y - totalH - 6) end

        menu.Size = UDim2.fromOffset(w, totalH)
        menu.Position = UDim2.fromOffset(px, py)
        st.open, st.anchor = true, anchor
        menu.Visible = true
    end

    ctx:Bind(S.UIS.InputBegan, function(inp)
        if st.open and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if not U.PointInGui(menu, inp.Position) and not U.PointInGui(st.anchor, inp.Position) then
                close()
            end
        end
    end)

    ctx.OpenContextMenu  = open
    ctx.CloseContextMenu = close
end

function U.BuildModals(ctx)
    local activeModal = nil

    local function closeActive()
        if not activeModal then return end
        local m = activeModal
        activeModal = nil
        if m.root and m.root.Parent then m.root:Destroy() end
    end

    local function createBaseModal(title, w, h)
        closeActive()
        ctx.CloseDropdown()
        ctx.CloseContextMenu()

        local body = U.New("Frame", {
            Name = "NeverloseModal", AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(w, h), Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundColor3 = Color3.fromRGB(9, 13, 22), BorderSizePixel = 0,
            ClipsDescendants = true, Visible = true, ZIndex = 146,
        }, ctx.Gui)
        U.Corner(body, 8)
        local stroke = U.Stroke(body, Color3.fromRGB(30, 44, 68), 1, 0.2)
        local scale = U.New("UIScale", {Scale = 0.95}, body)

        local hdr = U.New("Frame", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Color3.fromRGB(12, 17, 28), BorderSizePixel = 0, ZIndex = 147}, body)
        U.New("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = ctx.Theme.Border, BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 148}, hdr)
        ctx:MakeDraggable(hdr, body, {ScaleObj = scale, LiftMult = 1.015, Smoothness = 20, Strokes = {stroke}})

        U.New("TextLabel", {
            Size = UDim2.new(1, -54, 1, 0), Position = UDim2.fromOffset(14, 0),
            BackgroundTransparency = 1, Text = title, TextColor3 = ctx.Theme.TextWhite,
            TextSize = 13, Font = Enum.Font.GothamSemibold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 148,
        }, hdr)

        U.CreateCloseButton(ctx, hdr, closeActive)

        local inner = U.New("Frame", {
            Size = UDim2.new(1, -28, 1, -52), Position = UDim2.fromOffset(14, 46),
            BackgroundTransparency = 1, ZIndex = 147,
        }, body)

        activeModal = {root = body, scale = scale}
        ctx:Tween(scale, ctx:Dur(0.18), {Scale = 1})
        return inner, closeActive
    end

    -- 1. Диалог ввода (Create / Rename / Import)
    ctx.OpenInputModal = function(opts)
        local hasExtra = opts.ExtraLabel ~= nil
        local inner, close = createBaseModal(opts.Title or "Create", 390, hasExtra and 250 or 156)

        U.New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
            Text = opts.Label or "Name", TextColor3 = ctx.Theme.TextMuted,
            TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 148,
        }, inner)

        local nameBox = U.New("TextBox", {
            Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 20),
            BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0,
            Text = opts.Default or "", PlaceholderText = opts.Placeholder or "Enter name...",
            PlaceholderColor3 = ctx.Theme.TextMuted, TextColor3 = ctx.Theme.TextWhite,
            TextSize = 13, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false, ZIndex = 148,
        }, inner)
        U.Corner(nameBox, 6)
        local nStroke = U.Stroke(nameBox, ctx.Theme.Border, 1, 0.4)
        U.New("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, nameBox)
        nameBox.Focused:Connect(function() ctx:Tween(nStroke, 0.12, {Color = ctx.Theme.Accent, Transparency = 0.15}) end)
        nameBox.FocusLost:Connect(function() ctx:Tween(nStroke, 0.12, {Color = ctx.Theme.Border, Transparency = 0.4}) end)

        local extraBox
        if hasExtra then
            U.New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 62),
                BackgroundTransparency = 1, Text = opts.ExtraLabel, TextColor3 = ctx.Theme.TextMuted,
                TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 148,
            }, inner)

            extraBox = U.New("TextBox", {
                Size = UDim2.new(1, 0, 0, 66), Position = UDim2.fromOffset(0, 82),
                BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0,
                Text = opts.ExtraDefault or "", PlaceholderText = opts.ExtraPlaceholder or "Optional: paste shared code...",
                PlaceholderColor3 = ctx.Theme.TextMuted, TextColor3 = Color3.fromRGB(205, 218, 238),
                TextSize = 11, Font = Enum.Font.Code, TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top, MultiLine = true, TextWrapped = true,
                ClearTextOnFocus = false, ClipsDescendants = true, ZIndex = 148,
            }, inner)
            U.Corner(extraBox, 6)
            U.Stroke(extraBox, ctx.Theme.Border, 1, 0.45)
            U.New("UIPadding", {PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, extraBox)
        end

        local okBtn = U.MakeAccentButton(ctx, inner, opts.ConfirmText or "Create", 116, 30, UDim2.new(1, -116, 1, -32), nil, 148)
        local cancelBtn = U.MakeOutlineButton(ctx, inner, "Cancel", 86, 30, UDim2.new(1, -210, 1, -32), false, nil, 148)

        cancelBtn.MouseButton1Click:Connect(close)
        okBtn.MouseButton1Click:Connect(function()
            local nm = U.Storage.SafeName(nameBox.Text)
            local ex = extraBox and extraBox.Text or ""
            close()
            if opts.OnConfirm then task.defer(function() opts.OnConfirm(nm, ex) end) end
        end)
        task.defer(function() if nameBox and nameBox.Parent then nameBox:CaptureFocus() end end)
    end

    -- 2. Диалог Share / Export
    ctx.OpenShareModal = function(title, payload)
        local copied = U.Storage.CopyToClipboard(payload)
        local inner, close = createBaseModal(title or "Share", 440, 224)

        U.New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
            Text = copied and "Copied to clipboard! You can also copy it below:" or "Select and copy the code below (Ctrl+C):",
            TextColor3 = copied and Color3.fromRGB(92, 220, 148) or ctx.Theme.TextMuted,
            TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 148,
        }, inner)

        local box = U.New("TextBox", {
            Size = UDim2.new(1, 0, 1, -62), Position = UDim2.fromOffset(0, 24),
            BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0,
            Text = payload, TextColor3 = Color3.fromRGB(210, 224, 245),
            TextSize = 11, Font = Enum.Font.Code, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, MultiLine = true, TextWrapped = true,
            ClearTextOnFocus = false, TextEditable = false, ClipsDescendants = true, ZIndex = 148,
        }, inner)
        U.Corner(box, 6)
        U.Stroke(box, ctx.Theme.Border, 1, 0.4)
        U.New("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, box)

        local copyBtn = U.MakeAccentButton(ctx, inner, "Copy Again", 112, 28, UDim2.new(1, -112, 1, -28), nil, 148)
        local doneBtn = U.MakeOutlineButton(ctx, inner, "Close", 82, 28, UDim2.new(1, -202, 1, -28), false, nil, 148)

        copyBtn.MouseButton1Click:Connect(function()
            U.Storage.CopyToClipboard(payload)
            ctx.Notify("Clipboard", "Code copied to clipboard", "success")
        end)
        doneBtn.MouseButton1Click:Connect(close)
    end

end

