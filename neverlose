        ctx:Bind(S.UIS.InputEnded, function(inp) if drag and inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = false; ctx:Tween(dot, 0.14, {Size = UDim2.fromOffset(12, 12)}) end end)
