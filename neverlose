function U.CreateChevron(ctx, parent, pos, color)
    local holder = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(12, 12),
        Position = pos,
        BackgroundTransparency = 1,
        ZIndex = parent.ZIndex + 1,
    }, parent)

    local armL = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 2),
        Position = UDim2.fromOffset(4, 6), Rotation = 45,
        BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = holder.ZIndex,
    }, holder)
    U.Round(armL)

    local armR = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 2),
        Position = UDim2.fromOffset(8, 6), Rotation = -45,
        BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = holder.ZIndex,
    }, holder)
    U.Round(armR)

    return {
        SetState = function(_, open)
            local col = open and ctx.Theme.Accent or ctx.Theme.TextMuted
            local d = ctx:Dur(0.18)
            ctx:Tween(holder, d, {Rotation = open and 180 or 0})
            ctx:Tween(armL, d, {BackgroundColor3 = col})
            ctx:Tween(armR, d, {BackgroundColor3 = col})
        end
    }
end

