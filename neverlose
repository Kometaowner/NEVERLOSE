function U.BuildSearchPopup(ctx)
    local popup = U.New("Frame", {
        Name = "SearchPopup", Size = UDim2.fromOffset(310, 270),
        BackgroundColor3 = Color3.fromRGB(10, 15, 24), BorderSizePixel = 0, Visible = false, ZIndex = 110,
    }, ctx.Gui)
    U.Corner(popup, 8)
    U.Stroke(popup, ctx.Theme.Border, 1, 0.25)
    local scale = U.New("UIScale", {Scale = 0.95}, popup)

    local inFrame = U.New("Frame", {
        Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 10),
        BackgroundColor3 = ctx.Theme.BgElement, BorderSizePixel = 0, ZIndex = 111,
    }, popup)
    U.Corner(inFrame, 6)

    local input = U.New("TextBox", {
        Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1, Text = "", PlaceholderText = "Поиск функций...",
        PlaceholderColor3 = ctx.Theme.TextMuted, TextColor3 = ctx.Theme.TextWhite,
        TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, ZIndex = 112,
    }, inFrame)

    local results = U.New("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -54), Position = UDim2.fromOffset(8, 48),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), ZIndex = 111,
    }, popup)
    ctx:BindAccent(results, "ScrollBarImageColor3")
    U.New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4)}, results)

    local function close()
        if not ctx.SearchOpen then return end
        ctx.SearchOpen = false
        ctx.SearchIcon:SetColor(Color3.fromRGB(205, 215, 230), true)
        ctx:Tween(scale, ctx:Dur(0.16), {Scale = 0.95}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        U.StartFade(ctx, popup, 1, 0, ctx:Dur(0.16))
    end

    local function rebuild(query)
        U.FinishFade(ctx, popup)
        for _, ch in ipairs(results:GetChildren()) do
            if ch:IsA("GuiObject") then ch:Destroy() end
        end
        local q, found = string.lower(query or ""), 0
        for _, item in ipairs(ctx.SearchList) do
            local hay = string.lower(item.Name .. " " .. item.Tab.Name .. " " .. item.GroupName)
            if q == "" or string.find(hay, q, 1, true) then
                found += 1
                local btn = U.New("TextButton", {
                    Size = UDim2.new(1, -6, 0, 36), BackgroundColor3 = ctx.Theme.BgElement,
                    BackgroundTransparency = 0.5, BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 112,
                }, results)
                U.Corner(btn, 5)
                U.New("TextLabel", {
                    Size = UDim2.new(1, -16, 0, 17), Position = UDim2.fromOffset(10, 3),
                    BackgroundTransparency = 1, Text = item.Name, TextColor3 = ctx.Theme.TextWhite,
                    TextSize = 12, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 113,
                }, btn)
                U.New("TextLabel", {
                    Size = UDim2.new(1, -16, 0, 14), Position = UDim2.fromOffset(10, 19),
                    BackgroundTransparency = 1, Text = item.Tab.Name .. "  /  " .. item.GroupName,
                    TextColor3 = ctx.Theme.TextMuted, TextSize = 10, Font = Library.Font,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 113,
                }, btn)
                btn.MouseEnter:Connect(function() ctx:Tween(btn, ctx:Dur(0.12), {BackgroundColor3 = ctx.Theme.AccentDim, BackgroundTransparency = 0.1}) end)
                btn.MouseLeave:Connect(function() ctx:Tween(btn, ctx:Dur(0.12), {BackgroundColor3 = ctx.Theme.BgElement, BackgroundTransparency = 0.5}) end)
                btn.MouseButton1Click:Connect(function()
                    close()
                    item.Tab:Select()
                    if item.Subtab then item.Subtab:Select() end
                    if item.Highlight then task.delay(0.18, item.Highlight) end
                end)
            end
        end
        if found == 0 then
            U.New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1,
                Text = (ctx.Settings.Language == "English") and "Nothing found" or "Ничего не найдено",
                TextColor3 = ctx.Theme.TextMuted, TextSize = 12, Font = Library.Font, ZIndex = 112,
            }, results)
        end
    end

    input:GetPropertyChangedSignal("Text"):Connect(function()
        if ctx.SearchOpen then rebuild(input.Text) end
    end)

    ctx:Bind(S.UIS.InputBegan, function(inp)
        if ctx.SearchOpen and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if not U.PointInGui(popup, inp.Position) and not U.PointInGui(ctx.SearchBtn, inp.Position) then
                close()
            end
        end
    end)

    ctx.SearchInput = input
    ctx.CloseSearch = close
    ctx.ToggleSearch = function()
        if ctx.SearchOpen then close() return end
        ctx.CloseDropdown()
        ctx.CloseColorPicker()
        ctx.CloseKeybindMenu()
        local bp = ctx.SearchBtn.AbsolutePosition
        popup.Position = UDim2.fromOffset(bp.X - 278, bp.Y + 40)
        ctx.SearchOpen = true
        ctx.SearchIcon:SetColor(ctx.Theme.Accent, true)
        input.Text = ""
        rebuild("")
        scale.Scale = 0.95
        ctx:Tween(scale, ctx:Dur(0.22), {Scale = 1})
        U.StartFade(ctx, popup, 0, 1, ctx:Dur(0.2))
        task.defer(function() input:CaptureFocus() end)
    end
end

