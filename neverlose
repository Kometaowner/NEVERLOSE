        Text = string.upper(title), TextColor3 = Color3.fromRGB(92, 108, 132),
        TextSize = 11, Font = Library.Font, TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1, ZIndex = 15,
    }, section)

    local card = U.New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = ctx.Theme.BgGroup, BorderSizePixel = 0, LayoutOrder = 2, ZIndex = 14,
