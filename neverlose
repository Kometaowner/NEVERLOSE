function U.CreateHollowGearIcon(ctx, parent, sizePx, color, maskBg)
    local holder = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sizePx, sizePx),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, ZIndex = parent.ZIndex + 1,
    }, parent)

    local outlineParts = {}
    local bg = maskBg or Color3.fromRGB(8, 12, 20)
    local bw = math.max(5, math.floor(sizePx * 0.34))
    local cr = math.max(2, math.floor(bw * 0.4))

    for i = 0, 2 do
        local tooth = U.New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(bw, sizePx),
            Position = UDim2.new(0.5, 0, 0.5, 0), Rotation = i * 60,
            BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = holder.ZIndex,
        }, holder)
        U.Corner(tooth, cr)
        table.insert(outlineParts, tooth)
    end

    local bodyOut = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(math.floor(sizePx * 0.78), math.floor(sizePx * 0.78)),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = holder.ZIndex,
    }, holder)
    U.Round(bodyOut)
    table.insert(outlineParts, bodyOut)

    local cut  = math.max(3, math.floor(sizePx * 0.21))
    local inBw = math.max(2, bw - cut)
    local inH  = math.max(6, sizePx - cut)
    for i = 0, 2 do
        local cutTooth = U.New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(inBw, inH),
            Position = UDim2.new(0.5, 0, 0.5, 0), Rotation = i * 60,
            BackgroundColor3 = bg, BorderSizePixel = 0, ZIndex = holder.ZIndex + 1,
        }, holder)
        U.Corner(cutTooth, math.max(1, cr - 1))
    end

    local bodyIn = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(math.max(4, math.floor(sizePx * 0.78) - cut), math.max(4, math.floor(sizePx * 0.78) - cut)),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = bg, BorderSizePixel = 0, ZIndex = holder.ZIndex + 1,
    }, holder)
    U.Round(bodyIn)

    local ringSize = math.max(5, math.floor(sizePx * 0.34))
    local ring = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(ringSize, ringSize),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = bg, BorderSizePixel = 0, ZIndex = holder.ZIndex + 2,
    }, holder)
    U.Round(ring)
    local ringStroke = U.Stroke(ring, color, math.max(1.4, sizePx * 0.09), 0)

    return {
        Holder = holder,
        SetColor = function(_, c, anim)
            for _, p in ipairs(outlineParts) do
                if anim then ctx:Tween(p, ctx:Dur(0.16), {BackgroundColor3 = c}) else p.BackgroundColor3 = c end
            end
            if anim then ctx:Tween(ringStroke, ctx:Dur(0.16), {Color = c}) else ringStroke.Color = c end
        end,
        SetRotation = function(_, deg)
            ctx:Tween(holder, ctx:Dur(0.28), {Rotation = deg}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        end,
    }
end

function U.CreateSearchIcon(ctx, parent, sizePx, color)
    local holder = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sizePx, sizePx),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1,
    }, parent)

    local ls = math.floor(sizePx * 0.62)
    local lens = U.New("Frame", {
        Size = UDim2.fromOffset(ls, ls), Position = UDim2.fromOffset(1, 1),
        BackgroundTransparency = 1, ZIndex = parent.ZIndex + 1,
    }, holder)
    U.Round(lens)
    local stroke = U.Stroke(lens, color, 1.9, 0)

    local handle = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(math.floor(sizePx * 0.42), 2),
        Position = UDim2.fromOffset(math.floor(sizePx * 0.76), math.floor(sizePx * 0.76)),
        Rotation = 45, BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = parent.ZIndex + 1,
    }, holder)
    U.Round(handle)

    return {
        SetColor = function(_, c, anim)
            if anim then
                ctx:Tween(stroke, ctx:Dur(0.15), {Color = c})
                ctx:Tween(handle, ctx:Dur(0.15), {BackgroundColor3 = c})
            else
                stroke.Color, handle.BackgroundColor3 = c, c
            end
        end
    }
end

-- ============================================================================
-- УЛУЧШЕННЫЙ ПЕРЕКЛЮЧАТЕЛЬ NEVERLOSE (ЭЛАСТИЧНОЕ РАСТЯЖЕНИЕ + IMPULSE + HOVER)
-- ============================================================================
function U.CreateNeverloseSwitch(ctx, parent, pos, initialState)
    local track = U.New("Frame", {
        Size = UDim2.fromOffset(38, 18),
        Position = pos,
        BackgroundColor3 = initialState and Color3.fromRGB(18, 30, 56) or Color3.fromRGB(16, 22, 33),
        BorderSizePixel = 0,
        ClipsDescendants = false,
        ZIndex = parent.ZIndex + 1,
    }, parent)
    U.Round(track)

    local glow = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(22, 22),
        Position = initialState and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
        BackgroundColor3 = ctx.Theme.Accent,
        BackgroundTransparency = initialState and 0.72 or 1,
        BorderSizePixel = 0,
        ZIndex = track.ZIndex + 1,
    }, track)
    U.Round(glow)

    local knob = U.New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(14, 14),
        Position = initialState and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
        BackgroundColor3 = initialState and ctx.Theme.Accent or Color3.fromRGB(62, 74, 94),
        BorderSizePixel = 0,
        ZIndex = track.ZIndex + 2,
    }, track)
    U.Round(knob)

    local curState  = initialState or false
    local isHover   = false
    local animToken = 0

    local function getTrackColor(state, hovered)
        if state then
            local h, s = Color3.toHSV(ctx.Theme.Accent)
            return Color3.fromHSV(h, math.clamp(s * 0.75, 0, 1), hovered and 0.27 or 0.22)
        end
        return hovered and Color3.fromRGB(22, 30, 46) or Color3.fromRGB(16, 22, 33)
    end

    local function getKnobColor(state, hovered)
        if state then return ctx.Theme.Accent end
        return hovered and Color3.fromRGB(92, 106, 130) or Color3.fromRGB(62, 74, 94)
    end

    local function spawnRipple(atPos)
        if not track or not track.Parent then return end
        local ring = U.New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(14, 14),
            Position = atPos,
            BackgroundTransparency = 1,
            ZIndex = track.ZIndex + 1,
        }, track)
        U.Round(ring)
        local rStroke = U.Stroke(ring, ctx.Theme.Accent, 1.5, 0.25)

        local d = ctx:Dur(0.32)
        ctx:Tween(ring, d, {Size = UDim2.fromOffset(28, 28)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local tw = ctx:Tween(rStroke, d, {Transparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        if tw then
            tw.Completed:Connect(function()
                if ring and ring.Parent then ring:Destroy() end
            end)
        end
    end

    local function set(state, anim)
        curState = state
        animToken += 1
        local myTok = animToken

        local targetPos  = state and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0)
        local targetTrkC = getTrackColor(state, isHover)
        local targetKnbC = getKnobColor(state, isHover)

        if not anim then
            track.BackgroundColor3      = targetTrkC
            knob.Position               = targetPos
            knob.Size                   = UDim2.fromOffset(14, 14)
            knob.BackgroundColor3       = targetKnbC
            glow.Position               = targetPos
            glow.BackgroundColor3       = ctx.Theme.Accent
            glow.BackgroundTransparency = state and 0.72 or 1
            return
        end

        local totalD   = ctx:Dur(0.24)
        local stretchD = totalD * 0.44
        local settleD  = totalD * 0.75

        -- 1. Плавный цвет трека и импульс свечения
        ctx:Tween(track, totalD, {BackgroundColor3 = targetTrkC})
        ctx:Tween(glow, stretchD, {
            Position               = targetPos,
            Size                   = state and UDim2.fromOffset(27, 27) or UDim2.fromOffset(16, 16),
            BackgroundColor3       = ctx.Theme.Accent,
            BackgroundTransparency = state and 0.52 or 1,
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

        -- 2. Эластичное растяжение ползунка во время перелёта
        ctx:Tween(knob, stretchD, {
            Position         = targetPos,
            Size             = UDim2.fromOffset(20, 12),
            BackgroundColor3 = targetKnbC,
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

        if state then
            spawnRipple(targetPos)
        end

        -- 3. Пружинное восстановление круглой формы
        task.delay(stretchD * 0.85, function()
            if animToken ~= myTok or not knob or not knob.Parent then return end
            local restSize = isHover and UDim2.fromOffset(15, 15) or UDim2.fromOffset(14, 14)
            ctx:Tween(knob, settleD, {Size = restSize}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            if state then
                ctx:Tween(glow, settleD, {
                    Size = UDim2.fromOffset(isHover and 24 or 22, isHover and 24 or 22),
                    BackgroundTransparency = isHover and 0.62 or 0.72,
                }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            end
        end)
    end

    local function setHover(hovered)
        isHover = hovered
        local d = ctx:Dur(0.14)
        ctx:Tween(track, d, {BackgroundColor3 = getTrackColor(curState, hovered)})
        ctx:Tween(knob, d, {
            BackgroundColor3 = getKnobColor(curState, hovered),
            Size = hovered and UDim2.fromOffset(15, 15) or UDim2.fromOffset(14, 14),
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        if curState then
            ctx:Tween(glow, d, {
                Size = hovered and UDim2.fromOffset(24, 24) or UDim2.fromOffset(22, 22),
                BackgroundTransparency = hovered and 0.62 or 0.72,
            })
        end
    end

    local function setPressed(pressed)
        if pressed then
            ctx:Tween(knob, ctx:Dur(0.1), {Size = UDim2.fromOffset(18, 13)}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        end
    end

    table.insert(ctx.AccentCbs, function()
        if curState then set(true, false) end
    end)

    return { Track = track, Set = set, SetHover = setHover, SetPressed = setPressed }
end

